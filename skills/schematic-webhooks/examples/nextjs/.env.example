# Webhook secret shown in the Schematic dashboard when you create the webhook endpoint.
# Used as-is (UTF-8 bytes): do not hex- or base64-decode it.
SCHEMATIC_WEBHOOK_SECRET=your_schematic_webhook_secret

# Optional replay window in seconds. Unset or 0 = off (default).
# Hookdeck retries and replays resend the original timestamp, so leave this off
# when receiving through Hookdeck.
# SCHEMATIC_WEBHOOK_TOLERANCE_SECONDS=300
