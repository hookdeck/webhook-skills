# Checkout.com webhook SIGNATURE KEY — REQUIRED.
#
# Dashboard -> Developers -> Webhooks -> Create configuration ->
# "To generate a signature key to hash the webhook payload as an HMAC, select
# Generate key". Via the Workflows API it is actions[].signature.key
# (with signature.method: "HMACSHA256").
#
# Used AS-IS as a UTF-8 HMAC key — do NOT base64- or hex-decode it.
# On the current ("NAS") platform this is NOT your sk_... secret API key.
CHECKOUT_WEBHOOK_SIGNATURE_KEY=8V8x0dLK%AyD*DNS8JJr

# Checkout.com webhook AUTHORIZATION KEY — OPTIONAL.
#
# Only set this if you configured an Authorization header key on the webhook
# ("To generate an authorization header key ... select Generate key", or
# actions[].headers.Authorization on the Workflows API).
#
# It arrives VERBATIM — Checkout.com adds no "Bearer " prefix. Leave empty and
# the check is skipped; Cko-Signature is what proves body integrity.
CHECKOUT_WEBHOOK_AUTHORIZATION_KEY=

# Server port
PORT=3000
