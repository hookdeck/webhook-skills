# Signing secret from Sublime → Actions → (your webhook Action) → Click to reveal
SUBLIME_SECURITY_WEBHOOK_SECRET=your_webhook_action_signing_secret
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# Hookdeck retries and replays carry the original timestamp. A positive value opts in.
SUBLIME_SECURITY_TIMESTAMP_TOLERANCE_SECONDS=0
