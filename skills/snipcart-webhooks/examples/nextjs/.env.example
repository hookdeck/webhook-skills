# Snipcart SECRET API key — create one in your merchant dashboard.
# NOT the public API key from your front-end <script> snippet: Snipcart's REST API
# (which requestvalidation is part of) authenticates with a SECRET key.
# Keys are per-mode: a Test-mode key cannot read Live data, and vice versa.
# Server-side only — never prefix this with NEXT_PUBLIC_.
SNIPCART_SECRET_API_KEY=your_secret_api_key

# Optional: timeout (ms) for the call to app.snipcart.com/api/requestvalidation
SNIPCART_VALIDATION_TIMEOUT_MS=5000
