# Swoogo does not sign webhooks. Add a custom header to the webhook (headers: [{key, value}]).
# SWOOGO_WEBHOOK_HEADER is its name (default Authorization); SWOOGO_WEBHOOK_SECRET is the exact,
# whole header value, including any "Bearer " prefix you typed in Swoogo.
SWOOGO_WEBHOOK_HEADER=Authorization
SWOOGO_WEBHOOK_SECRET=Bearer your-secret
