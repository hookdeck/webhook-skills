# Holded webhook secret (Settings > Webhooks in Holded). It looks like whsec_...
# but it is NOT a Standard Webhooks secret: use the whole string, including the
# whsec_ prefix, as the plain HMAC-SHA256 key. Do not strip or base64-decode it.
HOLDED_WEBHOOK_SECRET=whsec_your_holded_webhook_secret

# Port the server listens on (default: 8000)
PORT=8000
