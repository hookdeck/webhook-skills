# Signing secret returned once by POST /v2/webhook-endpoints (starts with whsec_).
# Paste the whole secret, including the whsec_ prefix. SpherePay uses it as a plain HMAC key.
SPHEREPAY_WEBHOOK_SECRET=whsec_your_endpoint_signing_secret
PORT=3000

# Optional replay window in seconds. 0 or unset (default) turns the timestamp check off, because
# Hookdeck retries and replays resend the original Sphere-Timestamp. A positive value opts in
# (SpherePay's docs suggest 300).
SPHEREPAY_WEBHOOK_TOLERANCE_SECONDS=0
