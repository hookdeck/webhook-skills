# ZoomInfo verification token. In the ZoomInfo Admin Portal (Integrations > API & Webhooks)
# click "Generate New Token" on your webhook; ZoomInfo sends it back in the x-zoominfo-token header.
# Leave unset only while you run the one-time "Validate" step (see README); then set it.
ZOOMINFO_WEBHOOK_TOKEN=your_zoominfo_verification_token_here

# Server port (optional, defaults to 3000)
PORT=3000
