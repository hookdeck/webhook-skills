# Nium does not sign webhooks. Instead, Nium adds a static header to every request, agreed
# with Nium during client setup. The header name is yours to choose ('x-partner-key' is the
# docs' example).
NIUM_WEBHOOK_HEADER=x-partner-key
# The exact, whole header value you gave Nium, including any prefix such as 'Bearer '.
NIUM_WEBHOOK_SECRET=your-shared-secret
