# App secret used to sign webhook POSTs (X-Hub-Signature-256).
# The Threads docs don't say which secret signs: use the secret of the app the
# webhook is configured on (App Dashboard > Settings > Basic > App Secret). If
# verification keeps failing, try the Threads App Secret instead
# (Use cases > Threads API > Settings).
THREADS_APP_SECRET=your_app_secret_here

# Verify token: a string you choose. Must match the token entered next to the
# Callback URL in the App Dashboard. Used for the GET handshake.
THREADS_VERIFY_TOKEN=your_verify_token_here
