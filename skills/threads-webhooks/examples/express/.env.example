# Threads App Secret, which signs webhook POSTs (X-Hub-Signature-256).
# App Dashboard > Use cases > Customize > Settings in the Threads API use case.
# Not the Meta App Secret under App settings > Basic.
THREADS_APP_SECRET=your_threads_app_secret_here

# Verify token: a string you choose. Must match the token entered next to the
# Callback URL in the App Dashboard. Used for the GET handshake.
THREADS_VERIFY_TOKEN=your_verify_token_here
