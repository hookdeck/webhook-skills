# Name of the header you added under Additional Headers in the Mailparser Advanced Webhook.
# Case-insensitive. Defaults to X-Webhook-Secret.
MAILPARSER_WEBHOOK_HEADER=X-Webhook-Secret

# The EXACT header value you added, including any scheme prefix.
# Custom header: a random value from `openssl rand -hex 32`
# Basic Auth (Authorization header): Basic <base64(username:password)>
MAILPARSER_WEBHOOK_SECRET=your_random_secret
