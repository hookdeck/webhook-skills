# The signing_key you set on the RootFi webhook config (dashboard or POST /v4/core/webhook-config).
# RootFi does not generate one: choose a long random string. It is used as-is (UTF-8) as the HMAC key.
ROOTFI_WEBHOOK_SECRET=your_signing_key

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
ROOTFI_WEBHOOK_TOLERANCE_SECONDS=0
