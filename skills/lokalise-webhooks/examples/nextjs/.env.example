# The secret from the Lokalise Webhooks app (Apps > Webhooks > your webhook).
# Lokalise sends it unchanged in a request header. Auto-generated by default;
# you can also type your own value in the app.
LOKALISE_WEBHOOK_SECRET=replace-with-your-lokalise-webhook-secret

# Header Lokalise sends the secret in (case-insensitive).
# X-Secret is the default; use X-Api-Key or your custom header name if you chose one.
LOKALISE_WEBHOOK_HEADER=X-Secret
