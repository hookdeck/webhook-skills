# The webhook's config.basic_auth_username and config.basic_auth_password
MARQETA_WEBHOOK_USERNAME=your-basic-auth-username
MARQETA_WEBHOOK_PASSWORD=your-basic-auth-password
# Optional: the webhook's config.secret, to check X-Marqeta-Signature too
MARQETA_WEBHOOK_SECRET=
# sha256 (HMAC_SHA_256), sha1 (HMAC_SHA_1), or sha256,sha1 while switching
MARQETA_SIGNATURE_ALGORITHM=sha256
# Port the example server listens on
PORT=3000
