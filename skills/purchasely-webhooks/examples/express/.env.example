# The webhook shared secret from the Purchasely Console
# ([YOUR APP] > Settings > Webhooks). Used as-is (UTF-8), not decoded.
PURCHASELY_WEBHOOK_SECRET=replace-with-your-webhook-shared-secret

# Optional replay protection. Unset or 0 = off (the default). When set, requests whose
# X-PURCHASELY-TIMESTAMP is more than this many seconds from now are rejected. Leave it off
# behind Hookdeck: retries and replays resend the original timestamp.
# PURCHASELY_WEBHOOK_TOLERANCE_SECONDS=300
