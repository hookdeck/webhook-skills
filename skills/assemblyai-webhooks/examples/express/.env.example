# AssemblyAI does not sign webhooks. You choose a header name and value, pass them as
# webhook_auth_header_name / webhook_auth_header_value on the transcript request, and
# AssemblyAI sends that header on every delivery.
# Generate a value with: openssl rand -hex 32
ASSEMBLYAI_WEBHOOK_AUTH_HEADER_NAME=X-My-Webhook-Secret
ASSEMBLYAI_WEBHOOK_AUTH_HEADER_VALUE=replace-with-a-long-random-secret
