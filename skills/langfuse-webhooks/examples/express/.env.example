# Signing secret shown when you create the webhook action on the Langfuse automation
# (you can regenerate it later). Used as UTF-8 bytes, exactly as shown.
LANGFUSE_WEBHOOK_SECRET=your_langfuse_webhook_secret

# Optional: reject deliveries whose t= timestamp is further than this many seconds from now.
# Unset or 0 = off (default). Leave it off behind Hookdeck: retries and replays resend the
# original timestamp, so a window would reject legitimate retries.
# LANGFUSE_WEBHOOK_TOLERANCE_SECONDS=300
