# Secret key you entered (or generated) when enabling the HMAC signature checkbox on the
# webhook in Zoho Sign (Settings > Developer Settings > Webhooks). Zoho Sign cannot show
# it again, so save it when you create the webhook.
# Used as UTF-8 bytes: do NOT base64-decode it.
ZOHO_SIGN_WEBHOOK_SECRET=your_secret_key

# Port for the Express server
PORT=3000
