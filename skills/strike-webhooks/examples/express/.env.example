# The `secret` you chose when creating the Strike subscription (POST /v1/subscriptions).
# 10-50 characters, generated by you, e.g. `openssl rand -hex 24`. NOT your API key.
STRIKE_WEBHOOK_SECRET=replace-with-your-subscription-secret
# Optional: the old secret, only while rotating (PATCH /v1/subscriptions/{id}).
STRIKE_WEBHOOK_SECRET_PREVIOUS=
# Strike API key (dashboard.strike.me), used for the fetch-back call, not for verification.
STRIKE_API_KEY=your-strike-api-key
# Port the example server listens on
PORT=3000
# Optional: API base URL (defaults to https://api.strike.me).
# Sandbox: https://api.dev.strike.me (needs a sandbox API key from https://dev.dashboard.strike.me)
# STRIKE_API_BASE=https://api.strike.me
