# useSend webhook signing secret (Dashboard -> Webhooks -> your webhook).
# Paste the WHOLE secret, including the whsec_ prefix. useSend uses it as a plain HMAC key.
USESEND_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Optional: reject requests whose X-UseSend-Timestamp (Unix milliseconds) is further
# than this many seconds from now. Unset or 0 = off (the default).
# Hookdeck retries and replays resend the original timestamp, so leave it off behind Hookdeck.
# USESEND_WEBHOOK_TOLERANCE_SECONDS=300

PORT=3000
