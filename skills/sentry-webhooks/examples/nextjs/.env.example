# Sentry integration CLIENT SECRET — REQUIRED.
#
# Settings -> Developer Settings -> your integration -> Client Secret
# (https://sentry.io/settings/{org-slug}/developer-settings/).
#
# Used AS-IS as a raw UTF-8 HMAC key — do NOT base64- or hex-decode it, and do
# not strip any prefix.
#
# This is NOT the Client ID, NOT an auth/API token (sntrys_...), and NOT a DSN.
# Internal integrations show a token on the same settings page; that token is
# for calling Sentry's API, not for verifying webhooks.
SENTRY_CLIENT_SECRET=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90

# OPTIONAL replay dampener: seconds of Sentry-Hook-Timestamp drift to accept.
# Leave empty to skip the check.
#
# Sentry-Hook-Timestamp is UNIX SECONDS and is NOT part of the signed string, so
# this is NOT a cryptographic replay defence — an attacker replaying a captured
# body + signature forges the timestamp freely. Real protection is deduplication
# on the Request-ID header. 300 is a reasonable value if you want the dampener.
SENTRY_WEBHOOK_TOLERANCE_SECONDS=
