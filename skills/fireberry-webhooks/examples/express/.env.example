# Fireberry does not sign webhooks. You add a secret header to the webhook automation action
# (Header > Key / Value) and this app compares it with the value below.

# Name of the header you added in the automation (default: Authorization). Case-insensitive.
FIREBERRY_WEBHOOK_HEADER=Authorization

# The EXACT, whole header value you typed, including any "Bearer " prefix.
FIREBERRY_WEBHOOK_SECRET=Bearer your-long-random-secret
