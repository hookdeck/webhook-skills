# Name of the custom header you added to the webhook in Instantly
# (Integrations -> Webhooks -> Add headers, or the API v2 "headers" object).
# Case-insensitive. Defaults to Authorization.
INSTANTLY_WEBHOOK_HEADER=Authorization

# The EXACT header value you added, including any scheme prefix.
# Basic Auth example: Basic <base64(username:password)>
# Custom header example: a random value from `openssl rand -hex 32`
INSTANTLY_WEBHOOK_SECRET=Basic dXNlcm5hbWU6cGFzc3dvcmQ=
