# The base64 HMAC secret returned when the subscription key was created
# (auth.hmac.key1.secret, or key2 for a rotation key). Paylocity returns it only once.
# Paste it exactly as returned: the handler base64-decodes it to get the HMAC key.
PAYLOCITY_HMAC_SECRET=your-base64-hmac-secret

# Optional: reject deliveries whose x-pcty-timestamp is more than this many seconds from
# your clock. Paylocity recommends 300. Leave empty to skip the check.
PAYLOCITY_TIMESTAMP_TOLERANCE_SECONDS=
# Port the example server listens on
PORT=3000
