# Webhook secret from Chatim dashboard → your project → Webhooks (shown once, when the webhook is created)
CHATIM_WEBHOOK_SECRET=your_webhook_secret
PORT=3000

# Optional replay window in seconds. 0 or unset (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in
# (Chatim's own examples use 300).
CHATIM_WEBHOOK_TOLERANCE_SECONDS=0
