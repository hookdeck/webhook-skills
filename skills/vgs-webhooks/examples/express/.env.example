# Unique secret generated for the webhook integration in VGS Dashboard → Organization Settings → Notifications
VGS_WEBHOOK_SECRET=your_integration_secret
PORT=3000

# Optional freshness window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
VGS_TIMESTAMP_TOLERANCE_SECONDS=0
