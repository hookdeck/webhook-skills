# Signing secret of the PayNow webhook (PayNow dashboard -> Webhooks), used as-is (UTF-8)
PAYNOW_WEBHOOK_SECRET=your_paynow_signing_secret

# Optional replay protection. PayNow-Timestamp is Unix MILLISECONDS; this is in seconds.
# Unset or 0 = off (the default: Hookdeck retries and replays resend the original timestamp).
# PAYNOW_WEBHOOK_TOLERANCE_SECONDS=300

PORT=8000
