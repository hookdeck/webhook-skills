# Signing secret returned once by POST /webhooks. Use the whole string, including whsec_, as-is.
HAIL_WEBHOOK_SECRET=whsec_your_signing_secret
PORT=8000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# Hookdeck retries and replays carry the original timestamp (Hail re-signs its own). A positive value opts in.
HAIL_TIMESTAMP_TOLERANCE_SECONDS=0
