# Podium webhook signing secret: the `secret` you set when you created the webhook
# through the Podium webhook API. Use it as plain text (it is the HMAC key as-is).
# Webhooks created without a secret are unsigned and fail verification.
PODIUM_WEBHOOK_SECRET=your_webhook_secret

# Optional replay window in seconds (podium-timestamp is Unix MILLISECONDS; the
# example converts). Unset or 0 = off. Off by default because Hookdeck retries
# and replays resend the original timestamp.
# PODIUM_WEBHOOK_TOLERANCE_SECONDS=300

# Port the example server listens on
PORT=3000
