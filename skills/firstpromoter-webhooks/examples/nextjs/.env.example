# FirstPromoter does not sign webhooks. Add a custom header to the Webhooks v2 subscription
# (Settings > Integrations > Webhooks) and enter the same header here.
# Header name (default: Authorization)
FIRSTPROMOTER_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any "Bearer " prefix you typed
FIRSTPROMOTER_WEBHOOK_SECRET=Bearer your-secret-value
