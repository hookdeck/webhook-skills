# REQUIRED. The value you put in the Send webhook step's custom header.
# Drata does not publish a signing secret for workflow webhooks; this shared secret
# is how you authenticate them. Generate with: openssl rand -hex 32
DRATA_WEBHOOK_SECRET=

# OPTIONAL. The custom header name you entered in the Drata workflow step (case-insensitive).
DRATA_WEBHOOK_HEADER=X-Webhook-Secret

PORT=3000
