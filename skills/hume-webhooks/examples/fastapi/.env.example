# Hume webhook signing key
# Hume platform → Developers page → Generate signing key. It is a stable,
# per-account key; generating a new one immediately invalidates the old one.
HUME_WEBHOOK_SECRET=your_webhook_signing_key_here

# Optional replay/staleness hardening. Hookdeck retries and replays resend the
# original timestamp, so this is disabled (unset or 0) by default. If you enable
# it, pick a window larger than your longest retry delay (Hume's own example
# uses 180).
# X-Hume-AI-Webhook-Timestamp is Unix seconds.
HUME_WEBHOOK_TOLERANCE_SECONDS=0
