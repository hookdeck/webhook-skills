# Spree webhook endpoint secret_key (64-character hex string, shown only once
# when you create the webhook endpoint). Use it as-is: do NOT hex-decode it.
SPREE_WEBHOOK_SECRET=your_spree_webhook_endpoint_secret_key

# Optional: reject deliveries whose timestamp is older than N seconds (unset or 0 = off)
# SPREE_WEBHOOK_TOLERANCE_SECONDS=300
