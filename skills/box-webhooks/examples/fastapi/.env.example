# Primary signature key from the Box Developer Console → your app → Webhooks → Manage signature keys
BOX_WEBHOOK_SECRET=your_primary_signature_key

# Optional replay window in seconds. 0 or unset (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original BOX-DELIVERY-TIMESTAMP.
# Box suggests 600 (10 minutes); a positive value opts in.
BOX_WEBHOOK_TOLERANCE_SECONDS=0
