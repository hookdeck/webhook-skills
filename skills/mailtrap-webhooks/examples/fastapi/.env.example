# The per-webhook signing secret (32 hex characters) shown in the webhook's
# details in Mailtrap: Webhooks -> your webhook -> webhook details.
# It is used as a plain text HMAC key: do NOT hex-decode it.
# This is NOT your Mailtrap API token.
MAILTRAP_WEBHOOK_SECRET=your_32_hex_character_signing_secret

# Port the example server listens on
PORT=8000
