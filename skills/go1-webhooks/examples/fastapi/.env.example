# The secret_key you set on the Go1 webhook (max 64 characters, used as a raw UTF-8 string)
GO1_WEBHOOK_SECRET=your_secret_key

# Port the server listens on (default: 8000)
PORT=8000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
GO1_TIMESTAMP_TOLERANCE_SECONDS=0
