# Zoho Flow's Send Webhook action is not signed. Send a secret header: an API Key auth profile
# with header placement, or a header Param Name / Param Value on the action (No Authentication).
# ZOHO_FLOW_WEBHOOK_HEADER is the header name; ZOHO_FLOW_WEBHOOK_SECRET is its exact value.
ZOHO_FLOW_WEBHOOK_HEADER=X-Webhook-Secret
ZOHO_FLOW_WEBHOOK_SECRET=your-long-random-value

# Port the example server listens on
PORT=3000
