# Brex webhook signing secret: the "secret" with status ACTIVE from
# GET https://api.brex.com/v1/webhooks/secrets. Paste it as returned
# (with or without a whsec_ prefix); the handler base64-decodes it.
BREX_WEBHOOK_SECRET=your_brex_webhook_secret

# Optional freshness window in seconds (Brex's guide uses 60). Off by default:
# a delivery replayed later through a relay keeps its original timestamp.
# BREX_WEBHOOK_TOLERANCE_SECONDS=60

# Port the example server listens on
PORT=3000
