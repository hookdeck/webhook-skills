# Webhook secret from the Modem Pay dashboard: Developers > Webhooks. Use it as-is.
# Modem Pay's own snippets call this MODEM_WEBHOOK_SECRET or MODEM_PAY_SECRET_HASH; it's the same value.
# Test mode: use the secret that `modempay listen` prints (test and live secrets differ).
MODEM_PAY_WEBHOOK_SECRET=your_modem_pay_webhook_secret
