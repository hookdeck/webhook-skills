# ConfigCat webhook signing key, pasted WHOLE including the configcat_whsk_ prefix
# (Dashboard > Webhooks > your webhook > Signing keys). Keep a single key on the webhook.
CONFIGCAT_WEBHOOK_SECRET=configcat_whsk_your_signing_key
# Optional: reject deliveries whose X-ConfigCat-Webhook-Timestamp is older/newer than this many
# seconds. Unset or 0 = off (recommended behind Hookdeck, whose retries keep the original timestamp).
# CONFIGCAT_WEBHOOK_TOLERANCE_SECONDS=300
PORT=8000
