# Onfleet organisation-wide webhook secret (a HEX string).
# Onfleet dashboard: Configuration -> API & Webhook -> Show Secret
# (https://docs.onfleet.com/reference/secrets)
# One secret covers every webhook in the organisation. It is NOT your API key.
# The code hex-decodes this value before using it as the HMAC-SHA512 key.
ONFLEET_WEBHOOK_SECRET=your_hex_webhook_secret

# Port the server listens on (default: 8000)
PORT=8000
