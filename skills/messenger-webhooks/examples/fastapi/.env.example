# App Secret Meta signs webhook POSTs with (X-Hub-Signature-256).
# App Dashboard > App settings > Basic > App Secret.
MESSENGER_APP_SECRET=your_app_secret_here

# Verify token: a string you choose. Must match the Verify Token entered next to the
# Callback URL in Messenger > Settings. Used for the GET handshake.
MESSENGER_VERIFY_TOKEN=your_verify_token_here
