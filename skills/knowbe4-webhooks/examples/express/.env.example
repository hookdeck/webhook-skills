# KnowBe4 does not sign webhooks. Add a custom header with a secret value to the KSAT or PhishER webhook.
# Name of the custom header you added (looked up case-insensitively). Defaults to Authorization.
KNOWBE4_WEBHOOK_HEADER=Authorization
# The exact, WHOLE header value, including any "Bearer " prefix you typed in KnowBe4.
KNOWBE4_WEBHOOK_SECRET=Bearer replace-with-a-long-random-secret
