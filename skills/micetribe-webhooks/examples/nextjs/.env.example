# The signing secret you set on the MICEtribe webhook (POST/PUT /integrations/v1 webhooks).
# Used as UTF-8 bytes, not hex- or base64-decoded.
MICETRIBE_WEBHOOK_SECRET=your_webhook_signing_secret

# Optional: max age of X-Timestamp in seconds. Unset or 0 (default) skips the check, because
# Hookdeck retries and replays keep the original X-Timestamp. MICEtribe suggests rejecting old
# timestamps; 300 is a common value if you opt in.
MICETRIBE_WEBHOOK_TOLERANCE_SECONDS=0
