# Bindbee security signature secret, exactly as shown on the dashboard's Webhooks page
# (Security signature card, eye icon). No whsec_ prefix: it is used as raw UTF-8 bytes.
BINDBEE_WEBHOOK_SECRET=your_bindbee_security_signature_secret

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
BINDBEE_WEBHOOK_TOLERANCE_SECONDS=0
