# `secret` field returned once by POST /{administration_id}/webhooks.json. Used as-is.
# Lost it? Reveal it on the webhook's detail page in Moneybird (MFA confirmation required).
MONEYBIRD_WEBHOOK_SECRET=your_webhook_secret
PORT=8000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
MONEYBIRD_TIMESTAMP_TOLERANCE_SECONDS=0
