# Webhook secret, returned only once in the response when you create the webhook (POST /websets/v0/webhooks)
EXA_WEBHOOK_SECRET=your_webhook_secret
PORT=8000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
EXA_TIMESTAMP_TOLERANCE_SECONDS=0
