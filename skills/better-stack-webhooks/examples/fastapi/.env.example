# Better Stack does not sign webhooks. Configure the credential(s) your webhook sends (or both).
# A request passes if EITHER configured method matches. A method left unset is never used, and
# with neither configured every request is rejected.

# Custom header (recommended): add this header to the webhook's headers_template.
# The header name is yours to choose; the default is X-Better-Stack-Secret.
BETTER_STACK_WEBHOOK_HEADER=X-Better-Stack-Secret
# The header's exact value (compared whole, nothing is stripped or trimmed). Use a long random value.
BETTER_STACK_WEBHOOK_SECRET=

# Basic auth: the webhook's auth_username and auth_password
BETTER_STACK_WEBHOOK_USERNAME=
BETTER_STACK_WEBHOOK_PASSWORD=
