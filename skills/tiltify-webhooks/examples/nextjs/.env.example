# Tiltify Secret Webhook Signing Key (Webhook Endpoint > Overview in the Developer
# Dashboard). A 64-character hex string, used as-is (UTF-8 bytes, NOT hex-decoded)
# as the HMAC-SHA256 key.
TILTIFY_WEBHOOK_SECRET=your_tiltify_secret_webhook_signing_key

# Optional replay protection. Unset or 0 = off (the default), so Hookdeck retries
# and replays, which resend the original X-Tiltify-Timestamp, are still accepted.
# Set to e.g. 300 to reject timestamps more than 300 seconds from now.
# TILTIFY_WEBHOOK_TOLERANCE_SECONDS=300

# Port the server listens on (default: 3000)
PORT=3000
