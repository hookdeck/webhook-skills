# Signing key (nooks-webhook-signing-key-...) shown once after you save the webhook URL in Nooks. Used as-is.
NOOKS_WEBHOOK_SECRET=your_nooks_signing_key

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
NOOKS_TIMESTAMP_TOLERANCE_SECONDS=0

# Set to true ONLY while saving (activating) a Nooks URL that points straight at this app: the
# activation ping may be unsigned and no signing key exists yet. Unsigned requests are then
# acknowledged without processing. Leave unset (unsigned requests get 401) once you have the key.
NOOKS_ACCEPT_UNSIGNED_PING=false
