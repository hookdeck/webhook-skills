# Truework does NOT sign webhook payloads. Each webhook has an authentication
# token that Truework sends, unchanged, in the X-Truework-Token header.
# Copy it from Developer Settings > Webhooks (Sandbox or Production).
# With no token set the handler fails closed with 500.
# A deleted and recreated webhook gets a NEW token; update this value.
TRUEWORK_WEBHOOK_TOKEN=

PORT=3000
