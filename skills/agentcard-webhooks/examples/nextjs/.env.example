# The endpoint's secret, returned once by POST /api/v2/webhook_endpoints.
# Paste the WHOLE value including the whsec_ prefix: Agentcard uses it as a plain HMAC key.
AGENTCARD_WEBHOOK_SECRET=whsec_your_endpoint_secret


# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
AGENTCARD_TIMESTAMP_TOLERANCE_SECONDS=0
