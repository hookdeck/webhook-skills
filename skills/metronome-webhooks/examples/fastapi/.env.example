# Metronome webhook secret key (per webhook, shown when you create the webhook in Metronome)
# Used as-is: its UTF-8 bytes are the HMAC key (not hex- or base64-decoded).
METRONOME_WEBHOOK_SECRET=your_webhook_secret_key_here

# Optional: reject deliveries whose X-Metronome-Date is older than this many seconds.
# Unset or 0 = off (the default). Hookdeck retries and replays resend the original
# X-Metronome-Date, so a window rejects legitimate retries.
# METRONOME_WEBHOOK_TOLERANCE_SECONDS=300
