# Datacake webhooks are not signed. In Datacake, add a secret header under Headers on the webhook,
# then put the header name and the exact, whole header value here.
# The value is compared as-is: if you typed "Bearer ABC123" in Datacake, set it to "Bearer ABC123".
DATACAKE_WEBHOOK_HEADER=Authorization
DATACAKE_WEBHOOK_SECRET=Bearer your-long-random-token
