# Aimfox does not sign webhooks. Set an "Authentication Header" on the webhook in Aimfox
# (Workspace settings > Webhooks) and put the same header name and EXACT whole value here.
AIMFOX_WEBHOOK_HEADER=Authorization
# Include any "Bearer " or "Basic " prefix you typed in Aimfox.
AIMFOX_WEBHOOK_SECRET=Bearer your-secret
