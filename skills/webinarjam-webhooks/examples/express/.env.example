# WebinarJam does not sign requests. You add a secret header yourself in
# Profile > Integrations > Autoresponder > Custom Webhook > Authentication type.
#
# Name of the header WebinarJam sends (default: Authorization).
WEBINARJAM_WEBHOOK_HEADER=Authorization
# The EXACT, WHOLE header value, including any "Bearer " prefix you typed.
# Bearer token option: header name Authorization, value "Bearer <token>".
WEBINARJAM_WEBHOOK_SECRET=Bearer replace_with_a_long_random_token
