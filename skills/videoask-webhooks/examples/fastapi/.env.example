# VideoAsk does not sign webhooks. Add a secret header to the webhook in the Connect tab
# ("Add a secret") or through the API (PUT /forms/{form_id}/webhooks/{tag} with
# "headers": {"secret": "open-sesame"}).
# Name of that header (default: secret)
VIDEOASK_WEBHOOK_HEADER=secret
# Exact, whole header value, including any "Bearer " prefix you typed
VIDEOASK_WEBHOOK_SECRET=open-sesame
