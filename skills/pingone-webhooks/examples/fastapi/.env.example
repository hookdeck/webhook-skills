# PingOne does not sign webhooks. Authenticate with a header you add to the
# subscription (httpEndpoint.headers). Paste the exact header value you set there.
# Generate one with: openssl rand -hex 32
PINGONE_WEBHOOK_SECRET=replace-with-the-exact-header-value

# Name of the header you set on the subscription (case-insensitive).
# The value above is compared in full, so for "Authorization: Bearer abc" it is "Bearer abc".
PINGONE_WEBHOOK_HEADER=Authorization
