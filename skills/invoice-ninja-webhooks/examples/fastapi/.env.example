# Invoice Ninja does not sign webhooks. Add a secret header to the webhook in Invoice Ninja
# (Settings > Account Management > Webhooks > Headers key/value) and put the same pair here.
# Header name you chose (default: Authorization). Matched case-insensitively.
INVOICE_NINJA_WEBHOOK_HEADER=Authorization
# The EXACT, whole header value, including any "Bearer " prefix you typed in Invoice Ninja.
INVOICE_NINJA_WEBHOOK_SECRET=your-secret-header-value
