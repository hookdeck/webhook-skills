# REQUIRED. The value you put in the Trigger Webhook action's custom header.
# Freshdesk does not sign webhooks; this shared secret is how you authenticate them.
# Generate with: openssl rand -hex 32 (no spaces - Freshdesk skips headers with spaces)
FRESHDESK_WEBHOOK_SECRET=

# OPTIONAL. The custom header name you entered in Freshdesk (case-insensitive).
FRESHDESK_WEBHOOK_HEADER=X-Freshdesk-Webhook-Secret

PORT=3000
