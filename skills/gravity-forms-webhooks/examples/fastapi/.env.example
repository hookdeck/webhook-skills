# The random secret YOU generated (openssl rand -hex 32).
# In Gravity Forms: Form Settings > Webhooks > feed > Request Headers >
#   Name: X-Webhook-Secret   Value: <this value>
GRAVITY_FORMS_WEBHOOK_SECRET=your_random_secret_here

# Optional: header name, if you used something other than X-Webhook-Secret
# GRAVITY_FORMS_WEBHOOK_HEADER=X-Webhook-Secret

PORT=8000
