# Palmetto Finance does not sign webhooks. It sends the server API key it returned when you
# registered the webhook (shown only once) in a header on every delivery.
#
# Header name: apiKey by default; use api_key if your requests show that instead.
PALMETTO_FINANCE_WEBHOOK_HEADER=apiKey
# The exact, whole header value (include any prefix such as "Bearer " if the header carries one).
PALMETTO_FINANCE_WEBHOOK_SECRET=your-server-api-key
