# Signing secret from the endpoint card on the Webhooks > Endpoints page of Medusa Cloud
# (click the eye icon to reveal it). Rotating it invalidates the previous secret immediately.
MEDUSA_WEBHOOK_SECRET=your_endpoint_signing_secret

# Port the server listens on (default: 3000)
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# Hookdeck retries and replays carry the original timestamp. A positive value opts in.
MEDUSA_TIMESTAMP_TOLERANCE_SECONDS=0
