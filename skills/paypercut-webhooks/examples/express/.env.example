# The signing secret of your Paypercut webhook endpoint (Merchant Dashboard or Webhooks API).
# Used as-is, as UTF-8 bytes (do not hex- or base64-decode it).
PAYPERCUT_WEBHOOK_SECRET=your_endpoint_secret

# Optional: reject deliveries whose t= is older (or newer) than this many seconds.
# Unset or 0 = off (the default). Paypercut recommends 300, but Hookdeck retries and replays
# resend the original timestamp, so a window rejects legitimate retries.
PAYPERCUT_WEBHOOK_TOLERANCE_SECONDS=
