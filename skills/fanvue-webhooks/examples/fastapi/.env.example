# Fanvue webhook signing secret, used verbatim as the HMAC-SHA256 key.
#
# Which secret depends on how the endpoint was registered (they do not share one):
#   - Developer Area -> your app -> Events tab, or webhooks.destinations in
#     app-manifest.json: the per-app secret shown by "View signing secret".
#   - POST /webhooks/subscriptions: the per-subscription `signingSecret` returned
#     ONCE in the create response (whsec_ + 64 hex characters).
#
# Paste it exactly as given, including any whsec_ prefix. Do not strip or decode it.
FANVUE_WEBHOOK_SECRET=your_fanvue_signing_secret
