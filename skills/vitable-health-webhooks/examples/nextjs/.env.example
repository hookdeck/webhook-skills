# The webhook subscription's secret key (Vitable's team provides it on request; each
# subscription has its own). Used as UTF-8 bytes: do not hex- or base64-decode it.
VITABLE_WEBHOOK_SECRET=your_subscription_secret_key
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
VITABLE_WEBHOOK_TOLERANCE_SECONDS=0
