# Prividium webhook signing key (Standard Webhooks format, starts with whsec_)
# Returned once, in full, as `signing_key` when the webhook is created. Reads never return it.
# During a key rotation you can list old and new keys separated by commas: whsec_old,whsec_new
PRIVIDIUM_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
