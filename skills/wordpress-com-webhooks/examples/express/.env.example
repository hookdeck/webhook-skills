# WordPress.com webhooks are UNSIGNED: no HMAC, no signature header, no secret,
# no timestamp, no handshake. There is no signing key to configure here —
# anything named WORDPRESS_COM_WEBHOOK_SECRET would be fiction.
# (X-WC-Webhook-Signature belongs to WooCommerce, a different product.)

# REQUIRED. A long random token YOU add to the webhook URL you register in
# Settings -> Webhooks, e.g.
#   https://your-app.example.com/webhooks/wordpress-com?token=RANDOM
# Generate one with: openssl rand -hex 32
# The handler compares the `token` query param against this value in constant
# time. If this variable is UNSET the handler fails CLOSED (HTTP 500) — it never
# accepts unauthenticated deliveries. The token is visible to any site admin and
# may appear in proxy logs; rotate it if exposed.
WORDPRESS_COM_WEBHOOK_TOKEN=

# OPTIONAL. Your site slug or ID, used to re-fetch authoritative data from the
# WordPress.com REST API after a delivery (the payload is untrusted).
# e.g. example.wordpress.com
WORDPRESS_COM_SITE=
