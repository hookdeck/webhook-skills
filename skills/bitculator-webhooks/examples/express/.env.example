# Signing secret returned once by POST /api/v1/webhooks (starts with whsec_).
# Use the whole string as-is: keep the whsec_ prefix and do not base64-decode it.
BITCULATOR_WEBHOOK_SECRET=whsec_your_signing_secret
PORT=3000

# Optional replay window in seconds. Unset or 0 = off (default). Bitculator's own example rejects
# timestamps 300 s or more from now, so set 300 to match that when Bitculator calls you directly.
# Keep it off behind Hookdeck: retries and replays resend the original timestamp.
BITCULATOR_WEBHOOK_TOLERANCE_SECONDS=0
