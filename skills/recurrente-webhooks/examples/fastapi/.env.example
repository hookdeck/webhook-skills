# Recurrente endpoint signing secret (Svix format, starts with whsec_)
# Returned as `signingSecret` by POST /api/webhook_endpoints (and GET /api/webhook_endpoints/{id}); also in the Svix dashboard
# reachable from Configuración > Desarrolladores y API > Webhooks in your Recurrente account
RECURRENTE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
