# Signing secret for your endpoint: app.incident.io > Settings > Webhooks > your endpoint.
# The Standard Webhooks form is whsec_<base64>; an unprefixed value is used as UTF-8 bytes.
INCIDENT_IO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional replay window in seconds. Leave unset to skip the timestamp check and rely on
# deduplicating webhook-id instead. A 5-minute window can reject relayed/replayed deliveries.
# INCIDENT_IO_WEBHOOK_TOLERANCE_SECONDS=86400

PORT=3000
