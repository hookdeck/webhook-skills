# The secret you typed into the webhook in the Creator Dashboard
# (Configurations > Webhooks). Required: requests are rejected without it.
ROBLOX_WEBHOOK_SECRET=your-webhook-secret
# Replay window in seconds (default 300; Roblox's docs suggest up to 600)
ROBLOX_WEBHOOK_TOLERANCE_SECONDS=300
# Optional, only for the right-to-erasure worker: an Open Cloud API key with the
# data stores "Delete Entry" permission. NOT the webhook secret.
ROBLOX_OPEN_CLOUD_API_KEY=
PORT=8000
