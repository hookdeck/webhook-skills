# Ardoq webhook signing secret
# Ardoq → Preferences → Organization settings → Settings → Webhooks → Create Webhook
# (signing is on by default). The secret is shown ONCE, when it is created.
ARDOQ_WEBHOOK_SECRET=your_signing_secret_here

# Optional replay/staleness hardening. Hookdeck retries and replays resend the
# original timestamp, so this is disabled (unset or 0) by default. If you enable
# it, pick a window larger than your longest retry delay.
# X-Ardoq-Timestamp is Unix seconds.
ARDOQ_WEBHOOK_TOLERANCE_SECONDS=0

# Port the example server listens on
PORT=3000
