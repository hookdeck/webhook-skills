# v1 webhook secret generated by Top.gg when you save the webhook URL in your project's
# dashboard (Webhooks). Looks like whs_xxx; use the whole string, prefix included.
TOP_GG_WEBHOOK_SECRET=whs_xxxxx

# Port the server listens on (default: 3000)
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
TOP_GG_WEBHOOK_TOLERANCE_SECONDS=0
