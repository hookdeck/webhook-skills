# Signing secret from the Whop dashboard (Developer tab -> Secret column) or the
# `webhook_secret` returned by POST /api/v1/webhooks. Starts with ws_.
# Use it exactly as Whop gave it: do not strip the prefix or base64-decode it.
WHOP_WEBHOOK_SECRET=ws_your_signing_secret_here
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
WHOP_TIMESTAMP_TOLERANCE_SECONDS=0
