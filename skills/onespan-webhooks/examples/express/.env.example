# The FULL value of the Authorization header OneSpan Sign sends, including the "Basic " prefix.
# OneSpan sends: Authorization: Basic <callback key>
# The callback key is the raw key you registered (not base64 user:pass). Set it in
# OneSpan Sign under Admin > Event Notifications (Authentication Method: Basic) or via POST /api/callback.
ONESPAN_AUTHORIZATION=Basic myCallbackKey
