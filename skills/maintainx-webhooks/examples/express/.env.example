# MaintainX webhook secret (Settings > Integrations > Copy secret)
MAINTAINX_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: port the server listens on (default 3000)
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
MAINTAINX_TIMESTAMP_TOLERANCE_SECONDS=0
