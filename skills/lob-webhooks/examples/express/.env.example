# Lob webhook secret: Webhooks -> your webhook -> details page in the Lob dashboard
LOB_WEBHOOK_SECRET=your_lob_webhook_secret

# Optional replay protection. Unset or 0 = off (the default). Lob recommends 300 (5 minutes),
# but retries and replays re-send the original timestamp, so only enable this if your
# endpoint is called by Lob directly (not through Hookdeck or another retrying proxy).
# LOB_WEBHOOK_TOLERANCE_SECONDS=300

# Port the server listens on (optional, defaults to 3000)
PORT=3000
