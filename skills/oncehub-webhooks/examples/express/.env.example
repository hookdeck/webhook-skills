# Endpoint secret: Account Integrations > APIs & Webhooks > your webhook > View secret.
# Only v2 webhooks have one; v1 webhooks (no View secret option) are not signed.
ONCEHUB_WEBHOOK_SECRET=your_endpoint_secret

# Port the server listens on (default: 3000)
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
ONCEHUB_TIMESTAMP_TOLERANCE_SECONDS=0
