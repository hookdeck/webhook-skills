# ---------------------------------------------------------------------------
# SparkPost event webhooks are NOT signed. There is no HMAC, no signature
# header and no signing secret. Authentication is credential based and set by
# the webhook's `auth_type` field: none | basic | oauth2.
# ---------------------------------------------------------------------------

# Mode 1 (PRIMARY): Basic auth — webhook `auth_type: "basic"`, configured with
# `auth_credentials: { "username": "...", "password": "..." }`.
# These are credentials YOUR endpoint defines, NOT your SparkPost login.
# `username` is required; `password` is NOT required and may be empty.
SPARKPOST_WEBHOOK_USERNAME=basicauthuser
SPARKPOST_WEBHOOK_PASSWORD=a-long-random-string

# Mode 2 (optional): OAuth 2.0 client credentials — webhook
# `auth_type: "oauth2"`, configured with `auth_request_details.url` pointing at
# POST /oauth/token below. SparkPost then sends `Authorization: Bearer {token}`.
# The demo token endpoint checks these; in production use your real
# authorization server (Auth0/Okta/Keycloak) instead.
SPARKPOST_OAUTH_CLIENT_ID=CLIENT123
SPARKPOST_OAUTH_CLIENT_SECRET=9sdfj791d2bsbf

# Legacy (optional, deprecated): the `auth_token` field →
# X-MessageSystems-Webhook-Token header. Not available for new webhooks, but
# existing ones keep working. Also how RELAY webhooks authenticate.
# SPARKPOST_WEBHOOK_TOKEN=existing-webhook-token

# Next.js dev server port (SparkPost itself only posts to ports 80/443 — use a
# tunnel locally)
PORT=3000
