# Paxos does not sign webhooks. In Dashboard > Developer > Webhooks, set Auth Type to API Key and
# choose an API Key Header name and an API Key value. Put the same two values here.
# Header name Paxos will send (matched case-insensitively). Defaults to Authorization.
PAXOS_WEBHOOK_HEADER=X-Paxos-Webhook-Secret
# The exact, whole header value. If you typed "Bearer abc" as the API Key value, put "Bearer abc".
PAXOS_WEBHOOK_SECRET=your-api-key-value
