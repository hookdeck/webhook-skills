# Workspace HMAC secret from Plain: Settings > Request signing (workspace admins only)
PLAIN_WEBHOOK_SECRET=your_plain_hmac_secret

# Optional: reject deliveries whose webhookMetadata.webhookDeliveryAttemptTimestamp is older
# than this many seconds. Leave unset to disable (recommended behind Hookdeck, which replays).
# PLAIN_TOLERANCE_SECONDS=300

# Port the server listens on (optional, defaults to 3000)
PORT=3000
