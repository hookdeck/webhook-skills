# BambooHR webhook private key: Settings > Webhooks (Global) or `privateKey` in the Create Webhook response (Permissioned)
BAMBOOHR_WEBHOOK_SECRET=your_webhook_private_key
# Optional replay window in seconds. Unset or 0 = off (retries and replays resend the original timestamp)
BAMBOOHR_WEBHOOK_TOLERANCE_SECONDS=0
