# The FULL value of the Authorization header Belvo sends, including the scheme prefix.
# Payments Mexico: you enter a token in the Belvo portal and Belvo sends "Authorization: Bearer <token>".
# Payments Brazil: the field takes "an optional bearer token"; confirm the header with a test delivery.
# Aggregation: you enter "Bearer <token>" or "Basic <base64 username:password>" and Belvo sends it as is.
BELVO_AUTHORIZATION=Bearer 00000000-0000-0000-0000-000000000000
