# REQUIRED. The random secret YOU generated and configured as a custom header
# value on the Ordinal webhook's `headers` field. Ordinal NEVER issues a signing
# secret — there is no signature, no HMAC and no `whsec_` key.
#
#   openssl rand -hex 32
#
# Then set it on the webhook:
#   curl -X PATCH "https://app.tryordinal.com/api/v1/webhooks/{id}" \
#     -H "Authorization: Bearer $ORDINAL_API_KEY" \
#     -H "Content-Type: application/json" \
#     -d '{"headers":{"X-Webhook-Secret":"<this value>"}}'
#
# Unset => the handler FAILS CLOSED and rejects every delivery with 500.
ORDINAL_WEBHOOK_SECRET=replace_with_openssl_rand_hex_32

# OPTIONAL. The header name you chose in the webhook's `headers` object.
# This is NOT an Ordinal-defined header — the name is entirely your choice.
# Default: x-webhook-secret
ORDINAL_WEBHOOK_SECRET_HEADER=x-webhook-secret

# OPTIONAL. Workspace API key for CALLING Ordinal's API (managing webhooks,
# fetching post detail) as `Authorization: Bearer <key>`.
# This is NOT a webhook secret and never arrives on an inbound delivery.
ORDINAL_API_KEY=

PORT=3000
