# REQUIRED. The webhook's signing secret, which starts with whsec_. It is in the
# `signingSecret` field of the Create webhook response (POST /api/v1/webhooks)
# and on the webhook's configure page under Settings > Integrations > Webhooks.
# GET /webhooks and GET /webhooks/{id} don't return it.
# Unset => the handler fails closed and rejects every delivery with 500.
ORDINAL_WEBHOOK_SECRET=whsec_your_signing_secret

# OPTIONAL. Workspace API key for calling Ordinal's API (managing webhooks) as
# `Authorization: Bearer <key>`. Never sent on a delivery.
ORDINAL_API_KEY=

PORT=8000
