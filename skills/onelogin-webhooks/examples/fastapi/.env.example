# OneLogin Event Broadcaster webhooks are unsigned. Authenticate them with a custom header
# you add under Developers > Webhooks in the OneLogin admin portal.
# Name of that custom header (default: Authorization). Matched case-insensitively.
ONELOGIN_WEBHOOK_HEADER=Authorization
# The EXACT, whole header value you typed there, including any "Bearer " prefix.
ONELOGIN_WEBHOOK_SECRET=your-long-random-string
