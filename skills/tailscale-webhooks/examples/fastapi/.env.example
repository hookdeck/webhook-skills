# Webhook secret shown once when you create the endpoint on the Webhooks page of the
# Tailscale admin console (case-sensitive, looks like tskey-webhook-xxxxx)
TAILSCALE_WEBHOOK_SECRET=tskey-webhook-xxxxx

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
TAILSCALE_TIMESTAMP_TOLERANCE_SECONDS=0
