# AfterShip webhook secret for the ONE product this endpoint receives.
#
# Each AfterShip product has its OWN secret — they are not interchangeable:
#   Tracking            admin.aftership.com  -> Settings > Webhooks
#   Shipping (Postmen)  admin.postmen.com    -> Settings > Webhooks
#   Returns             AfterShip Returns    -> webhook settings
#   Warranty            AfterShip Warranty   -> webhook settings
#
# Used verbatim as UTF-8 bytes: do NOT base64-decode it and do NOT add a prefix.
# The signature is base64(HMAC-SHA256(this secret, raw request body)), delivered in
# aftership-hmac-sha256 (Tracking), as-signature-hmac-sha256 (Returns/Warranty), or
# am-webhook-signature (Shipping and pre-Oct-2022 Returns, as "hmac-sha256=<digest>").
AFTERSHIP_WEBHOOK_SECRET=your_webhook_secret

# Port for the FastAPI server
PORT=8000
