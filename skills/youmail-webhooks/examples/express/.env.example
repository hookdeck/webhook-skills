# The FULL value of the Authorization header YouMail sends, including the "Bearer " prefix.
# Create the YouMail webhook with auth "Bearer" and a token. Expected form (not printed by YouMail):
#   Authorization: Bearer <token>
# If deliveries are rejected, capture one and copy the value exactly.
# Do not strip the prefix. Basic auth is not supported by this example.
YOUMAIL_AUTHORIZATION=Bearer 00000000-0000-0000-0000-000000000000
