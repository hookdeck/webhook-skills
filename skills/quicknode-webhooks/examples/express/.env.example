# The stream's or webhook's security token from the Quicknode dashboard (used as UTF-8 text)
QUICKNODE_WEBHOOK_SECRET=your_security_token_here

# Optional: reject deliveries whose X-QN-Timestamp is older than this many seconds.
# Unset or 0 = off (the default). Leave it off behind Hookdeck: retries and replays resend the
# original timestamp, so a window would reject legitimate retries.
# QUICKNODE_WEBHOOK_TOLERANCE_SECONDS=300
