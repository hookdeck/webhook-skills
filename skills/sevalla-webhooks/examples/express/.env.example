# Signing secret from Sevalla: Tools > Webhooks > your webhook > Overview > Signing secret.
# Paste the whole value, including the whsec_ prefix. It is sent as-is in the svl-signature header.
SEVALLA_WEBHOOK_SECRET=whsec_your_signing_secret
# Optional: the previous secret, only while a rolled secret is still rolling over.
# SEVALLA_WEBHOOK_SECRET_OLD=
