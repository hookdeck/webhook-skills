# Endpoint signing secret from BigMailer (Webhooks settings -> "show")
BIGMAILER_WEBHOOK_SECRET=your_endpoint_signing_secret
PORT=8000

# Optional replay window in seconds. 0 or unset (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
BIGMAILER_WEBHOOK_TOLERANCE_SECONDS=0
