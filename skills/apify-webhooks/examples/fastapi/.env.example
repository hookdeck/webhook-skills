# Apify does not sign webhooks. Add a secret header with the webhook's Headers template,
# e.g. {"X-Webhook-Secret": "your-random-secret"}, and mirror it here.
# Header name from the Headers template (default: X-Webhook-Secret)
APIFY_WEBHOOK_HEADER=X-Webhook-Secret
# The exact, whole header value (including any "Bearer " prefix you typed)
APIFY_WEBHOOK_SECRET=your-random-secret
