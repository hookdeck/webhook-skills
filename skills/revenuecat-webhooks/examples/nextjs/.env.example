# Set at least one of the two values below. Requests are rejected with 401 when
# a configured check fails, and with 500 when neither is set.

# HMAC signing secret (opt-in). Toggle "HMAC webhook signing" on the webhook
# integration in the RevenueCat dashboard. The secret is shown ONCE, at creation
# or rotation; if you lose it, rotate to get a new one. Used as a UTF-8 key.
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_signing_secret

# The exact Authorization header value you entered on the webhook integration
# (for example "Bearer some-long-random-token"). Compared in constant time.
REVENUECAT_WEBHOOK_AUTH=Bearer your_authorization_header_value

# Port the server listens on (default: 3000)
PORT=3000
