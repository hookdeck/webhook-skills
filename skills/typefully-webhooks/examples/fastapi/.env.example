# Webhook secret from Typefully's API settings (used as-is, as UTF-8)
TYPEFULLY_WEBHOOK_SECRET=your_typefully_webhook_secret
PORT=8000

# Optional replay window in seconds. Unset or 0 (default) turns the timestamp check off, because
# Hookdeck's retries and replays carry the original timestamp (Typefully doesn't document whether its
# own retries do). A positive value opts in.
TYPEFULLY_WEBHOOK_TOLERANCE_SECONDS=0
