# Pleo webhook subscription secret (Standard Webhooks / Svix, "whsec_" + base64).
# Pleo generates it per subscription. Read it with the Subscriptions API:
#   GET https://external.pleo.io/v1/subscriptions/{id}/secret  -> data.secretKey
PLEO_WEBHOOK_SECRET=whsec_your_subscription_secret_here

# Port the example server listens on
PORT=3000
