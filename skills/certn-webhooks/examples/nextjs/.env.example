# Signing secret from the Certn Partner page (signed payloads must be enabled). Used as-is, as UTF-8.
CERTN_WEBHOOK_SECRET=your_certn_signing_secret
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
CERTN_TIMESTAMP_TOLERANCE_SECONDS=0
