# Freshsales has no signing secret. You choose a secret and add it as a custom header on the
# workflow's Trigger webhook action (format "X-Webhook-Secret: VALUE"). Prefer a long random hex
# value with no spaces: Freshsales skips triggers whose header contains spaces.
# Name of the custom header (matched case-insensitively). Defaults to X-Webhook-Secret.
FRESHSALES_WEBHOOK_HEADER=X-Webhook-Secret
# The exact, whole header value you entered, including any prefix such as "Bearer ".
FRESHSALES_WEBHOOK_SECRET=replace-with-a-long-random-hex-value
