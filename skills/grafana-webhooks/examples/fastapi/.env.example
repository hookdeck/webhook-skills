# Grafana Alerting webhook contact point → Optional Webhook settings → HMAC Signature

# REQUIRED. The contact point's HMAC "Secret", used AS-IS as UTF-8 bytes.
# Not base64-decoded, no prefix, and NOT a Grafana API key or service-account token.
# HMAC is optional in Grafana, but this example fails closed without it.
GRAFANA_WEBHOOK_SECRET=your_hmac_secret_here

# OPTIONAL. The contact point's HMAC "Header" field. This is the default value;
# only set it if you customised the header name in Grafana.
GRAFANA_SIGNATURE_HEADER=X-Grafana-Alerting-Signature

# OPTIONAL. The contact point's HMAC "Timestamp Header" field. There is NO default
# name — leave this empty and Grafana signs the body alone. Set it (to whatever
# name you chose in Grafana) and Grafana signs timestamp + ":" + body, which is
# what makes replay protection possible. Grafana's provisioning docs use
# X-Grafana-Alerting-Signature-Timestamp as their example name.
GRAFANA_TIMESTAMP_HEADER=

# OPTIONAL. Replay window in seconds, only used when GRAFANA_TIMESTAMP_HEADER is
# set. Grafana documents NO tolerance — this default is our choice, not Grafana's.
GRAFANA_MAX_AGE_SECONDS=300

# Server port
PORT=8000
