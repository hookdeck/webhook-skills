# Basic Auth credentials you embed in the Deepgram callback URL
# (https://username:password@your-domain.com/webhooks/deepgram)
DEEPGRAM_CALLBACK_USERNAME=your_callback_username
DEEPGRAM_CALLBACK_PASSWORD=your_callback_password

# Optional: Deepgram API Key ID (found in Deepgram console)
# Used to check the dg-token header when Deepgram sends it (not on every callback)
DEEPGRAM_API_KEY_ID=your_api_key_id_here

# Port for the Express server
PORT=3000
