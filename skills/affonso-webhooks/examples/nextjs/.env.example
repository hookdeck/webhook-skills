# Signing secret from Affonso dashboard → Settings → Webhooks → (your endpoint).
# A 64-character hex string, shown once. Used as-is as a string key (not hex-decoded).
AFFONSO_WEBHOOK_SECRET=your_64_character_hex_signing_secret
PORT=3000

# Optional replay window in seconds. 0 or unset (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
AFFONSO_WEBHOOK_TOLERANCE_SECONDS=0
