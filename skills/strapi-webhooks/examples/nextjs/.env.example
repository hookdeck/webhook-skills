# Strapi does not sign webhooks. Authenticate them with a header you configure in Strapi
# (per webhook in the admin panel, or `webhooks.defaultHeaders` in config/server).
# Name of that header (default: Authorization). Matched case-insensitively.
STRAPI_WEBHOOK_HEADER=Authorization
# The EXACT, whole header value, including any "Bearer " prefix you typed in Strapi.
STRAPI_WEBHOOK_SECRET=Bearer my-very-secured-token
