# Signing secret of the webhook (Dashboard -> Webhooks -> your webhook). Paste the whole secret,
# including the whsec_ prefix. Lettermint uses it as a plain HMAC key.
LETTERMINT_WEBHOOK_SECRET=whsec_xxxxx

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in
# (Lettermint's SDKs use 300).
LETTERMINT_WEBHOOK_TOLERANCE_SECONDS=0
