# Signing secret shown for the webhook in Formspree. Used as UTF-8 bytes, as-is
# (do not hex- or base64-decode it).
FORMSPREE_WEBHOOK_SECRET=your_formspree_signing_secret

# Optional replay protection. Unset or 0 = off (the default).
# Hookdeck retries and replays resend the original Formspree-Signature header,
# so a window rejects legitimate redeliveries. Value is in seconds.
# FORMSPREE_WEBHOOK_TOLERANCE_SECONDS=300

# Port the server listens on (default: 3000)
PORT=3000
