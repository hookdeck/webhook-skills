# Deck webhook signing secret (Standard Webhooks, "whsec_" + base64).
# Deck does NOT generate this — create it yourself, then pass the SAME value as
# `webhook.secret` when creating the destination (POST /v2/event-destinations).
# It cannot be retrieved from Deck afterwards, so store it here/in your vault.
#   node -e "console.log('whsec_' + require('crypto').randomBytes(32).toString('base64'))"
DECK_WEBHOOK_SECRET=whsec_your_base64_secret_here

# Optional: the previous secret during a rotation. Deck keeps the old secret
# valid for 24 hours; remove this once the rollover window has passed.
DECK_WEBHOOK_SECRET_PREVIOUS=

# Port the example server listens on
PORT=3000
