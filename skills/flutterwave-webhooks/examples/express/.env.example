# The secret hash you set in the Flutterwave dashboard under Settings > Webhooks.
# v4 webhooks sign the raw body with it (flutterwave-signature); v3 webhooks send it
# as-is in verif-hash. Flutterwave's own samples call this variable FLW_SECRET_HASH.
FLUTTERWAVE_SECRET_HASH=your-secret-hash

# Port the example server listens on
PORT=3000
