# Webhook Secret Key from ReferralHero. Turn on "Payload Verification" for the webhook
# (Edit Campaign > Integrations > Webhooks) and a secret is generated; it is also shown under
# the profile menu (Webhook Secret) and each campaign's Integration > Webhook tab.
# This is NOT your ReferralHero API key. Used as-is (UTF-8 bytes), not decoded.
REFERRALHERO_WEBHOOK_SECRET=your_webhook_secret_key_here

PORT=3000
