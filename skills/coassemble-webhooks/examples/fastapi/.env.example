# Signing secret from Coassemble → Developer → Webhooks (returned once, when the endpoint is created)
COASSEMBLE_WEBHOOK_SECRET=your_webhook_secret
PORT=3000

# Optional replay window in seconds. 0 or unset (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in
# (Coassemble's own examples use 300).
COASSEMBLE_WEBHOOK_TOLERANCE_SECONDS=0
