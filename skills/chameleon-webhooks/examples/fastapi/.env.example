# Chameleon Webhook Secret: Integrations -> Webhooks in the Chameleon dashboard.
# Used as-is (UTF-8 text) as the HMAC-SHA256 key.
CHAMELEON_WEBHOOK_SECRET=your_webhook_secret

# Optional: reject a body whose sent_at is more than this many seconds from now (400).
# Chameleon's sample uses 300. Leave unset to skip the check.
# CHAMELEON_SENT_AT_TOLERANCE_SECONDS=300
