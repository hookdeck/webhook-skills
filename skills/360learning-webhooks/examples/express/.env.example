# 360Learning signing secret of the subscription: Settings > Webhooks > See secret,
# or GET /api/v2/webhooks/subscriptions/{subscriptionId}/secrets. Paste it as
# shown, with or without a whsec_ prefix; the handler base64-decodes it.
# Each subscription (one per event type) has its own secret: if this route
# receives several subscriptions, list every secret, comma-separated.
THREE_SIXTY_LEARNING_WEBHOOK_SECRET=your_360learning_signing_secret

# Optional freshness window in seconds (360Learning suggests 5 minutes). Off by
# default: a delivery replayed later through a relay keeps its original timestamp.
# THREE_SIXTY_LEARNING_WEBHOOK_TOLERANCE_SECONDS=300

# Port the example server listens on
PORT=3000
