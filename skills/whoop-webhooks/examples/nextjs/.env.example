# Your WHOOP app's client secret from the Developer Dashboard.
# WHOOP signs webhooks with it; there is no separate webhook secret.
WHOOP_WEBHOOK_SECRET=your_whoop_client_secret_here

# Optional: reject timestamps (Unix milliseconds) older/newer than this many seconds.
# Unset or 0 = off (the default, so Hookdeck retries and replays still verify).
# WHOOP_WEBHOOK_TOLERANCE_SECONDS=300
