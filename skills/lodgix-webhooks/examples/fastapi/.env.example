# Secret from your Lodgix webhook endpoint (Modules > Integrations > Webhooks)
LODGIX_WEBHOOK_SECRET=your_endpoint_secret

# Optional: reject requests whose X-Lodgix-Timestamp is older than this many seconds.
# Unset or 0 = off (Hookdeck retries and replays resend the original timestamp).
LODGIX_WEBHOOK_TOLERANCE_SECONDS=0
