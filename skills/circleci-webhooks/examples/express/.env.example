# The "Secret token" you set on the webhook in CircleCI:
#   Project Settings -> Webhooks -> Add/Edit Webhook -> Secret token
# (v2 API field name: `signing-secret`)
#
# You choose this value -- CircleCI does not generate it. Use something long and
# random: `openssl rand -hex 32`
#
# It is used as UTF-8 bytes DIRECTLY: no prefix to strip, no base64 decoding.
#
# This is NOT your CircleCI API token (Circle-Token). That one authenticates you
# calling CircleCI; this one verifies CircleCI calling you.
#
# The field is optional in CircleCI's web UI, which means a webhook can be saved
# with no secret and deliver UNSIGNED requests. This example refuses to run
# without one (it returns 500 rather than accepting unverified traffic).
CIRCLECI_WEBHOOK_SECRET=your_webhook_secret_token

# Port the example server listens on
PORT=3000
