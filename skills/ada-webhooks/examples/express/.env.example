# Signing secret of your Ada webhook endpoint ("whsec_" + base64).
# Ada dashboard: Config > PLATFORM > Webhooks > your endpoint > Signing Secret,
# or GET https://<your-ai-agent>.ada.support/api/v2/webhooks/{id}/secret/
# Each endpoint has its own secret.
ADA_WEBHOOK_SECRET=whsec_your_signing_secret_here

PORT=3000
