# Bringg does not sign webhooks. Authenticate with a Static Header you add to the webhook
# (Settings > Platform Integrations > Webhooks > Headers, Key-Value pairs).

# Header name you chose as the Key (case-insensitive). Defaults to Authorization.
BRINGG_WEBHOOK_HEADER=Authorization

# The exact, whole header value you entered, including any "Bearer " prefix.
# Generate a token with: openssl rand -hex 32
BRINGG_WEBHOOK_SECRET=Bearer replace-with-a-long-random-token
