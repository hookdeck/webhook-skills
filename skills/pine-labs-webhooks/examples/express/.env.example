# Pine Labs secret key: Settings in the Pine Labs Online dashboard.
# Paste it exactly as shown, without adding a whsec_ prefix.
PINE_LABS_WEBHOOK_SECRET=your_pine_labs_secret_key

# Port the example server listens on
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
PINE_LABS_WEBHOOK_TOLERANCE_SECONDS=0
