# HMAC secret provisioned by Shippo (request "HMAC Webhook Setup" from your account manager).
# When set, every request must carry a valid Shippo-Auth-Signature header.
SHIPPO_WEBHOOK_SECRET=your_shippo_hmac_secret

# Self-generated token appended to your webhook URL as ?token=...
# Use this until HMAC is provisioned, or together with it. Generate with: openssl rand -hex 32
SHIPPO_WEBHOOK_TOKEN=

PORT=3000

# Optional replay window in seconds for Shippo-Auth-Signature timestamps.
# 0 (default) turns the check off, because retries and replays carry the original timestamp.
# A positive value opts in.
SHIPPO_TIMESTAMP_TOLERANCE_SECONDS=0
