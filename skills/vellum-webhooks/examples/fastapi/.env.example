# Vellum Monitoring webhooks are unsigned. Authenticate with the header you configured in
# Organization settings > Monitoring Integration > Webhook Integration.
# Header name: "Authorization" for Bearer Token, or the custom name you chose for API Key Header.
VELLUM_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any "Bearer " prefix you typed.
VELLUM_WEBHOOK_SECRET=Bearer your-token
