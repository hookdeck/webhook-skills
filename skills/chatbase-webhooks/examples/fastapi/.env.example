# Event webhooks (leads.submit, phone_call.summary, custom forms, collect data)
# Chatbase signs these with HMAC-SHA1 of the raw body in x-chatbase-signature
CHATBASE_WEBHOOK_SECRET=your_chatbase_webhook_secret

# Optional: HIPAA conversation webhook (Settings > HIPAA, Enterprise only)
# 64-character hex signing secret shown once when you first save the endpoint
CHATBASE_HIPAA_WEBHOOK_SECRET=your_64_char_hex_signing_secret

