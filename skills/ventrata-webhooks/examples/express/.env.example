# Ventrata webhooks are not signed. Add a secret header in the webhook's headers map when you
# create it through the OCTO API, then enter the same name and value here.
# Header name you chose (looked up case-insensitively).
VENTRATA_WEBHOOK_HEADER=X-Webhook-Secret
# The exact, whole header value, including any "Bearer " prefix you typed.
VENTRATA_WEBHOOK_SECRET=your-secret-value
