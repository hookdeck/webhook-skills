# CharityStack webhook secret, used as-is (UTF-8 bytes) as the HMAC-SHA256 key.
# CharityStack shows the webhook secret only once, when you create the webhook
# (POST /v1/webhooks). Copy it from that response; if you lose it, delete the
# webhook and create a new one.
CHARITYSTACK_WEBHOOK_SECRET=your_charitystack_webhook_secret

# Optional replay protection. Unset or 0 = off (the default), so Hookdeck retries
# and replays, which resend the original X-Webhook-Timestamp, are still accepted.
# Set to e.g. 300 to reject timestamps more than 300 seconds from now.
# CHARITYSTACK_WEBHOOK_TOLERANCE_SECONDS=300

# Port the server listens on (default: 8000)
PORT=8000
