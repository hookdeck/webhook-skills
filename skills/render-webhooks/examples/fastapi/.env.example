# Render webhook signing secret (Standard Webhooks).
# Copy it from Integrations > Webhooks > your webhook > Settings in the
# Render Dashboard. Paste it exactly as shown; the standardwebhooks library
# strips an optional "whsec_" prefix and base64-decodes the rest.
RENDER_WEBHOOK_SECRET=whsec_your_render_signing_secret

# Port the example server listens on
PORT=8000
