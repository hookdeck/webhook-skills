# Daytona webhook signing secret (Svix endpoint secret: "whsec_" + base64).
# Open the endpoint's details page in the Daytona Dashboard → Webhooks.
DAYTONA_WEBHOOK_SECRET=whsec_your_secret_here

# Port the example server listens on
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
DAYTONA_TIMESTAMP_TOLERANCE_SECONDS=0
