# Datto RMM Global Webhooks are unsigned. Add a secret header under
# Setup > Integrations > Global Webhooks > Add Header, then mirror it here.
# Name of the header you added (default Authorization).
DATTO_RMM_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any "Bearer " prefix you typed.
DATTO_RMM_WEBHOOK_SECRET=your-secret-header-value
