# The Event Subscription's shared_secret (Increase dashboard or the Event
# Subscriptions API). Used as raw UTF-8 bytes: do not base64-decode it, and do not use a
# value that starts with whsec_.
INCREASE_WEBHOOK_SECRET=your_shared_secret
PORT=8000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
INCREASE_TIMESTAMP_TOLERANCE_SECONDS=0
