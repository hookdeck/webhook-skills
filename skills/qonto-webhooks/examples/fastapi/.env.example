# Qonto webhook subscription secret (32-128 chars). Paste the WHOLE value,
# including any whsec_ prefix: Qonto uses it as a plain HMAC key.
QONTO_WEBHOOK_SECRET=whsec_your_subscription_secret_here
# Optional: reject deliveries whose t= is older/newer than this many seconds.
# Unset or 0 = off (Qonto documents no tolerance; Hookdeck retries keep the original t).
# QONTO_WEBHOOK_TOLERANCE_SECONDS=300
PORT=8000
