# Scaleway's CA trust chain, downloaded once (the fr-par and nl-ams files are currently identical):
#   curl -o sns-trust-chain.pem https://messaging.s3.fr-par.scw.cloud/fr-par/sns/sns-trust-chain.pem
SCALEWAY_SNS_TRUST_CHAIN_PATH=./sns-trust-chain.pem

# Recommended: accept only your own topics (comma-separated). A valid signature proves Scaleway sent
# the message, not that it came from your topic.
SCALEWAY_SNS_TOPIC_ARNS=arn:scw:sns:fr-par:your-project-id:your-topic

# Optional: hosts SigningCertURL may point to (default: messaging.s3.fr-par.scw.cloud)
# SCALEWAY_SNS_CERT_HOSTS=messaging.s3.fr-par.scw.cloud

# Optional replay window in seconds on the signed Timestamp. Unset or 0 = off (default).
# Keep it off behind Hookdeck: retries and replays resend the original envelope.
SCALEWAY_SNS_MAX_AGE_SECONDS=0
