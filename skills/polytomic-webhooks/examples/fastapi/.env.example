# REQUIRED. The connection Secret from Polytomic.
#
# Connections -> your Webhook connection -> hover the secret key field to reveal
# its value. Polytomic sends this exact value back on every request as
#   Authorization: Bearer <secret>
#
# This is NOT a signing secret. Polytomic does not sign its webhooks — there is
# no HMAC, no digest and no signature header. The bearer token is the ONLY
# authentication. If this is unset the handler fails closed with 500.
#
# The value may look like a JWT (the docs' example does). Treat it as an opaque
# string: do not decode it, do not jwt.verify() it.
POLYTOMIC_WEBHOOK_SECRET=

# OPTIONAL. Freshness window for the Polytomic-Signature-Timestamp header, in
# seconds. Default 300 (the docs suggest rejecting requests "more than a few
# minutes old"). Set to 0 to disable the check entirely.
#
# DEFENCE-IN-DEPTH ONLY. That header is an RFC 3339 timestamp, NOT a signature,
# and it is not covered by any signature — so this proves nothing about
# authenticity. It only limits replay of an old captured request.
POLYTOMIC_TIMESTAMP_TOLERANCE_SECONDS=300

# Optional. Port for the example server.
PORT=8000
