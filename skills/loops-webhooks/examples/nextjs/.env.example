# Loops webhook signing secret from Settings -> Webhooks
# (https://app.loops.so/settings?page=webhooks). Paste it as shown, with or
# without a whsec_ prefix; the handler strips the prefix and base64-decodes it.
# Loops' own example names this variable LOOPS_SIGNING_SECRET.
LOOPS_WEBHOOK_SECRET=your_loops_signing_secret

# Optional freshness window in seconds (Loops' example uses 300). Off by default:
# a delivery replayed later through a relay keeps its original timestamp.
# LOOPS_WEBHOOK_TOLERANCE_SECONDS=300
