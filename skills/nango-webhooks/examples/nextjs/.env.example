# Nango webhook signing key: Environment Settings > Webhooks > Signing key.
# This is NOT the environment API key. Each environment has its own key.
NANGO_WEBHOOK_SIGNING_KEY=your_nango_webhook_signing_key

# Nango environment API key: Environment Settings > API key.
# The @nangohq/node constructor requires it (and you need it to fetch synced records).
NANGO_API_KEY=your_nango_api_key
