# The exact header value of the API key keychain on Make's HTTP > Make a request module
# (the "Key" field, sent as entered, including any prefix such as "Bearer ").
# Generate a secret with: openssl rand -hex 32
MAKE_WEBHOOK_SECRET=Bearer replace-with-a-long-random-secret

# Header name = the keychain's "API key parameter name" (case-insensitive).
MAKE_WEBHOOK_HEADER=Authorization
