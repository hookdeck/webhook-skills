# Webhook secret from the Magic Hour Developer Hub (Webhooks tab).
# Paste the whole secret, including the whsec_ prefix. Magic Hour uses it as a plain HMAC key.
MAGIC_HOUR_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Optional: reject deliveries whose magic-hour-event-timestamp is more than this many seconds
# from now. Unset or 0 = off (the default), so retries and replays still verify.
# MAGIC_HOUR_WEBHOOK_TOLERANCE_SECONDS=300
