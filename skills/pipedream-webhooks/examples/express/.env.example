# Signing key for Pipedream Connect TRIGGER webhooks (x-pd-signature).
# Shown once when you save a webhook URL in project settings, or returned as
# `signing_key` by the Set Project Environment Webhook / Deploy Trigger APIs.
# Used verbatim (UTF-8) as the HMAC-SHA256 key.
PIPEDREAM_WEBHOOK_SIGNING_KEY=your_pipedream_signing_key

# Optional. Connection webhooks (CONNECTION_SUCCESS / CONNECTION_ERROR) are NOT
# signed. If set, /webhooks/pipedream/connect requires ?token=<this value>, so
# create Connect tokens with webhook_uri=https://your-host/webhooks/pipedream/connect?token=<this value>
PIPEDREAM_CONNECT_WEBHOOK_TOKEN=

# Port the server listens on (default: 3000)
PORT=3000
