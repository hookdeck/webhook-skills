# Webhook secret for your Wave app (see references/setup.md: Wave's guide doesn't say where it is shown)
WAVE_WEBHOOK_SECRET=your_webhook_secret
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. Wave suggests 300.
WAVE_TIMESTAMP_TOLERANCE_SECONDS=0
