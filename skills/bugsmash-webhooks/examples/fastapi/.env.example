# BugSmash webhook signing secret. Returned ONCE as `secret_key` when you create the
# webhook with POST https://api.bugsmash.io/api/v2/webhook. Paste the whole value,
# including the bgsmsh_ prefix (it is the HMAC key as-is).
BUGSMASH_WEBHOOK_SECRET=bgsmsh_your_secret_key_here

# Optional replay window in seconds (X-Webhook-Timestamp is Unix seconds).
# Unset or 0 = off. Off by default because Hookdeck retries and replays resend
# the original timestamp.
# BUGSMASH_WEBHOOK_TOLERANCE_SECONDS=300

# Port the example server listens on
PORT=8000
