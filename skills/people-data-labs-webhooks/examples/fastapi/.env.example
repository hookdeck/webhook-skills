# PDL does not sign webhooks. Ask the People Data Labs team to include a secret header
# when they register your webhook, then mirror it here.
# Header name PDL sends (default: Authorization)
PEOPLE_DATA_LABS_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any "Bearer " prefix you gave PDL
PEOPLE_DATA_LABS_WEBHOOK_SECRET="Bearer your-shared-key"
