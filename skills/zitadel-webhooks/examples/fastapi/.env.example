# signingKey returned when you create the ZITADEL target (PAYLOAD_TYPE_JSON)
ZITADEL_WEBHOOK_SECRET=your_target_signing_key

# Optional replay window in seconds. Unset or 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
ZITADEL_WEBHOOK_TOLERANCE_SECONDS=0
