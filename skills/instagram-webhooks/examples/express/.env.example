# Secret Meta signs webhook POSTs with (X-Hub-Signature-256).
# Meta's docs say the App Secret (App Dashboard > App settings > Basic). If your app
# uses Instagram API with Instagram Login and verification fails, try the Instagram
# app secret (Instagram > API setup with Instagram login > Business login settings).
INSTAGRAM_APP_SECRET=your_app_secret_here

# Verify token: a string you choose. Must match the Verify Token entered next to the
# Callback URL in the App Dashboard. Used for the GET handshake.
INSTAGRAM_VERIFY_TOKEN=your_verify_token_here
