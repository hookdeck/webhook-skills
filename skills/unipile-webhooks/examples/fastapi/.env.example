# REQUIRED. The value you put in the webhook's "headers" array when creating it.
# Unipile does not sign webhooks; this shared secret is how you authenticate them.
# Generate with: openssl rand -hex 32
UNIPILE_WEBHOOK_SECRET=

# OPTIONAL. The header key you used in the webhook's "headers" array (case-insensitive).
UNIPILE_WEBHOOK_HEADER=Unipile-Auth

PORT=8000
