# Signing secret shown once when you create the Jamie webhook with "Signature Verification"
# (use as-is; do not decode it). API key mode is not supported.
JAMIE_WEBHOOK_SECRET=your_signing_secret
PORT=3000

# Optional replay window in seconds. Default 0 (off). Jamie's docs recommend 300 (5 minutes) when
# Jamie calls you directly. Keep 0 behind Hookdeck: retries and replays resend the original timestamp.
JAMIE_TIMESTAMP_TOLERANCE_SECONDS=0
