# Signing secret shown once when you create the Jamie webhook with "Signature Verification"
# (use as-is; do not decode it). API key mode is not supported.
JAMIE_WEBHOOK_SECRET=your_signing_secret
PORT=3000

# Replay window in seconds. Default 300 (Jamie's 5 minutes); 0 disables it.
# Hookdeck retries and replays keep the original timestamp, so behind Hookdeck set this to 0.
JAMIE_TIMESTAMP_TOLERANCE_SECONDS=300
