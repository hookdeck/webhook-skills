# Jamf Pro webhooks are unsigned. Authenticate them with Header Authentication:
# on the Jamf Pro webhook choose "Header Authentication" and enter JSON such as
#   {"Authorization": "Bearer your-long-random-secret"}
# The JSON key is the header name, the JSON value is the header value.

# Header name (the JSON key). Defaults to Authorization. Matched case-insensitively.
JAMF_PRO_WEBHOOK_HEADER=Authorization

# The exact, whole header value, including any "Bearer " prefix you typed.
JAMF_PRO_WEBHOOK_SECRET=Bearer your-long-random-secret
