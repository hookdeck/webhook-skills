# The FULL value of the Authorization header Iterable sends, including the scheme prefix.
#   Authentication = OAuth 2.0 -> Iterable sends "Authorization: Bearer <token>"
#   Authentication = Basic     -> Iterable sends exactly what you typed in Authentication Token,
#                                 e.g. "Authorization: Basic abc123" (not necessarily base64)
# Set this to the complete value as Iterable sends it, prefix included.
ITERABLE_AUTHORIZATION=Bearer 00000000-0000-0000-0000-000000000000
