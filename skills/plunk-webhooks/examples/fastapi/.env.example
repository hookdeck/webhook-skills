# Plunk does not sign webhooks. You add a secret header on the workflow's webhook step
# (Headers, as JSON) and this app compares it.
# Header name you chose (default: Authorization). Looked up case-insensitively.
PLUNK_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any "Bearer " prefix you typed in Plunk.
# Use a static value, not a {{variable}}.
PLUNK_WEBHOOK_SECRET=Bearer your-shared-secret
