# Webhooks by Zapier does NOT sign requests. Authenticate them with a shared
# secret you add to the Zap's webhook action. Configure at least one method;
# with neither set the handler fails closed with 500.

# Option A: shared-secret header. In the Zap action's Headers section add
#   X-Webhook-Secret | <this value>
# Generate one with: openssl rand -hex 32
ZAPIER_WEBHOOK_SECRET=

# Option B: HTTP Basic Auth. In the Zap action's Basic Auth field enter
#   <username>|<password>   (pipe-separated)
ZAPIER_BASIC_AUTH_USERNAME=
ZAPIER_BASIC_AUTH_PASSWORD=

PORT=3000
