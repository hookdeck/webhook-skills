# Ultravox webhook secret (used as-is, as UTF-8 bytes - do not decode it)
# Give the Ultravox webhook exactly ONE secret and paste it here
ULTRAVOX_WEBHOOK_SECRET=your_ultravox_webhook_secret_here

# Optional: reject deliveries whose X-Ultravox-Webhook-Timestamp is older than this many seconds.
# Unset or 0 = off (the default). Hookdeck retries and replays resend the original timestamp,
# so leave this off when receiving through Hookdeck.
# ULTRAVOX_WEBHOOK_TOLERANCE_SECONDS=60

PORT=8000
