# Webhook secret shown when you create the webhook in Luma (Settings → Developer → Webhooks).
# Starts with whsec_ and is used whole, as a UTF-8 string, for the HMAC key
LUMA_WEBHOOK_SECRET=whsec_xxxxx

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
LUMA_TIMESTAMP_TOLERANCE_SECONDS=0
