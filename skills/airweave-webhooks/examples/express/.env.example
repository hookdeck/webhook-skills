# Airweave webhook signing secret: the `secret` field (whsec_...) returned by
#   GET https://api.airweave.ai/webhooks/subscriptions/{id}?include_secret=true
# If you supplied a custom secret when creating the subscription, paste the
# whsec_ value Airweave returns, not the value you sent.
AIRWEAVE_WEBHOOK_SECRET=whsec_your_secret_here

# Port the example server listens on
PORT=3000
