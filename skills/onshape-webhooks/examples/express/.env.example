# Primary webhook signature key (Company/Classroom/Enterprise settings > Webhooks)
ONSHAPE_WEBHOOK_SECRET=your_primary_signature_key
# Optional: reject deliveries whose X-onshape-webhook-timestamp is older than this
# many seconds. Unset or 0 = off (the default; Hookdeck retries and replays resend
# the original timestamp).
# ONSHAPE_WEBHOOK_TOLERANCE_SECONDS=0
