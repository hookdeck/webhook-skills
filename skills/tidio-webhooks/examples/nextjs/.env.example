# Webhook secret from Tidio: Settings > Developer > Webhooks
TIDIO_WEBHOOK_SECRET=your_tidio_webhook_secret

# Optional: reject deliveries whose signed timestamp is older than this many
# seconds. Unset or 0 = off (the default). Hookdeck retries and replays resend
# the original timestamp, so leave this off behind Hookdeck.
# TIDIO_WEBHOOK_TOLERANCE_SECONDS=300

# Port the server listens on (optional, defaults to 3000)
PORT=3000
