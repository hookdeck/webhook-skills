# Access Worldpay Event-Signature shared secret(s), one env var per keyId:
#   WORLDPAY_WEBHOOK_SECRET_<keyId>=<shared secret>
# The keyId is the first field of each Event-Signature entry ({keyId}/SHA256/{hex}).
# Your Worldpay Implementation Manager enables signing and sends the secret.
# This is NOT your Access Worldpay API username/password.
WORLDPAY_WEBHOOK_SECRET_1=your-worldpay-shared-secret
# During key renewal Worldpay signs with two keys. Add the second one here,
# then remove the old one when Worldpay finishes the renewal:
# WORLDPAY_WEBHOOK_SECRET_2=
# The Next.js dev server runs on port 3000
