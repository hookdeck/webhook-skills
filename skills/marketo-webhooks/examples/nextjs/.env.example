# REQUIRED. The value you put in the webhook's custom header (Webhook Actions > Set Custom Header).
# Marketo does not sign webhooks; this shared secret is how you authenticate them.
# Generate with: openssl rand -hex 32
MARKETO_WEBHOOK_SECRET=

# OPTIONAL. The custom header name you entered in Marketo (case-insensitive).
MARKETO_WEBHOOK_HEADER=X-Webhook-Secret

PORT=3000
