# Azure Logic Apps HTTP action → Advanced parameters → Authentication / Headers
# Logic Apps does not sign requests. Configure at least one method below;
# every method you configure must pass. With nothing set, the handler returns 500.

# Basic authentication: the action's "Username" and "Password".
# Logic Apps sends Authorization: Basic base64(username:password).
AZURE_LOGIC_APPS_USERNAME=
AZURE_LOGIC_APPS_PASSWORD=

# Shared secret sent in a header you add under the action's "Headers".
AZURE_LOGIC_APPS_SHARED_SECRET=
# Header that carries the secret (case-insensitive). Default: x-logic-apps-secret.
# For Raw authentication, set this to Authorization and set the secret to the full
# Raw "Value" (for example: Bearer <token>). Don't combine Raw with Basic.
AZURE_LOGIC_APPS_SECRET_HEADER=x-logic-apps-secret

# Server port
PORT=3000
