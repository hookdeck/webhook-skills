# Full signing secret from GET /api/v1/webhooks/{id}/secret, whsec_ prefix included
DIAL_WEBHOOK_SECRET=whsec_your_signing_secret
# Optional: max age of the signed timestamp in seconds. Unset or 0 = no check (Hookdeck
# retries/replays keep the original timestamp); set 300 for Dial's suggested 5 minutes
DIAL_WEBHOOK_TOLERANCE_SECONDS=
PORT=3000
