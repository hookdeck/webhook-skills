# Signing secret of your Featurebase webhook (Settings > Developers > Webhooks).
# Paste the whole secret, including the whsec_ prefix. Featurebase uses it as a plain HMAC key.
FEATUREBASE_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Optional replay protection. Unset or 0 = off (the default).
# Hookdeck retries and replays resend the original X-Webhook-Timestamp, so a window rejects them.
# FEATUREBASE_WEBHOOK_TOLERANCE_SECONDS=300
