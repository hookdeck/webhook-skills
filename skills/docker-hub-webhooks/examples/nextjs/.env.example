# Docker Hub repository webhooks are UNSIGNED — there is no signing secret to
# configure here, because Docker Hub does not have one. No signature header, no
# HMAC, no timestamp, no auth option.

# REQUIRED. A long random token YOU place in the webhook URL you register in
# Docker Hub, e.g. https://your-app.example.com/webhooks/docker-hub/<token>
# This is NOT a Docker Hub signature — it is your own secret echoed back to you,
# so it is visible to Docker Hub and to anything that logs request paths. Rotate
# it periodically and keep the route out of access logs.
#
# Generate with: openssl rand -hex 32
# Mind Docker Hub's limit: the registered URL must be 255 characters or fewer.
#
# If this is unset the handler FAILS CLOSED with 500 — it never silently accepts.
DOCKER_HUB_WEBHOOK_TOKEN=

# OPTIONAL. Comma-separated allowlist of repository.repo_name values. When set,
# a push for any other repository is rejected with 403, so someone who learns
# the URL can't trigger actions for a repo they control.
DOCKER_HUB_ALLOWED_REPOS=

# OPTIONAL. Used ONLY to re-confirm the pushed tag against the Docker Hub API
# before acting on it (GET /v2/namespaces/{namespace}/repositories/{repository}
# /tags/{tag}). Left unset, the confirmation step is skipped entirely.
#
# A PAT/OAT is NOT a bearer token for the Hub API. It is the `secret` you POST to
# https://hub.docker.com/v2/auth/token together with your username or org as
# `identifier`; the response's `access_token` is the short-lived JWT you then send
# as "Authorization: Bearer <jwt>". Sending the raw dckr_pat_... value gets a 401.
#
# Note: GetRepositoryTag needs no auth at all for PUBLIC repositories — set these
# only for private ones.
DOCKER_HUB_API_IDENTIFIER=
DOCKER_HUB_API_TOKEN=
