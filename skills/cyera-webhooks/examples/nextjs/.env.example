# Cyera Privacy Webhook Secret, from the webhook integration in Cyera Privacy
# (examples in Cyera's docs look like `dgwebhook...`). Used as-is: the HMAC key
# is the secret's UTF-8 bytes. Do NOT hex- or base64-decode it.
CYERA_WEBHOOK_SECRET=dgwebhook_your_webhook_secret

# Optional replay tolerance in seconds. Unset or 0 = off (the default).
# X-Webhook-Timestamp is Unix seconds. Leave this off if you receive through
# Hookdeck: retries and replays resend the ORIGINAL timestamp, so a fixed
# window would reject legitimate redeliveries.
# CYERA_WEBHOOK_TOLERANCE_SECONDS=300

# Port for the Next.js server
PORT=3000
