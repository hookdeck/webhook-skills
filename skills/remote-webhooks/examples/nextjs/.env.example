# The callback's signing_key, returned by POST /v1/webhook-callbacks (there is no dashboard field).
# Used as-is, as UTF-8 text: do not hex- or base64-decode it.
REMOTE_WEBHOOK_SECRET=your_signing_key_here

# Optional replay protection. Unset or 0 = off (the default). X-Remote-Timestamp is Unix
# MILLISECONDS; this value is in seconds. Leave it off behind Hookdeck: retries and replays
# resend the original timestamp and would be rejected.
# REMOTE_WEBHOOK_TOLERANCE_SECONDS=300
