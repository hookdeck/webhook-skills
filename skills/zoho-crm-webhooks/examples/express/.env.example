# Zoho CRM webhooks are not signed. Add a Custom Parameter under the webhook's Header
# (Setup > Automation > Actions > Webhooks) and use POST or PUT: CRM sends no headers on GET/DELETE.
# ZOHO_CRM_WEBHOOK_HEADER is its Parameter Name; ZOHO_CRM_WEBHOOK_SECRET is its exact Parameter Value.
ZOHO_CRM_WEBHOOK_HEADER=X-Webhook-Secret
ZOHO_CRM_WEBHOOK_SECRET=your-long-random-value

# Port the example server listens on
PORT=3000
