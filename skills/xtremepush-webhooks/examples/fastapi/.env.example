# Webhook Secret Key from the Xtremepush webhook integration (Signed Payload auth type).
# Used as-is, as UTF-8 bytes.
XTREMEPUSH_WEBHOOK_SECRET=your_xtremepush_webhook_secret_key
PORT=8000

# Optional replay window in seconds. Unset or 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
XTREMEPUSH_WEBHOOK_TOLERANCE_SECONDS=0
