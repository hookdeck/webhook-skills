# The FULL value of the Authorization header Procore sends, exactly as entered in the
# "Authorization Header" field of the Procore webhook (hook), including any "Bearer " or "Basic "
# prefix. Do not strip or decode it. Example from the Procore docs: Basic c3a24b8208ac5199d083d54a1234e94b8864
PROCORE_AUTHORIZATION=Basic c3a24b8208ac5199d083d54a1234e94b8864
