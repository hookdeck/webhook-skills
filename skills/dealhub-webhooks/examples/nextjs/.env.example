# DealHub webhook authentication. Set ONE of the two options below to match the
# Authentication Type chosen in DealHub (System Settings -> API Settings -> Webhooks).

# Token mode: the secret token you entered in DealHub.
# DealHub sends it as the full header value "Authorization: Bearer <TOKEN>".
DEALHUB_WEBHOOK_TOKEN=your_shared_secret_token

# Basic mode: the username and password you entered in DealHub.
# DealHub sends "Authorization: Basic <CREDENTIALS>" (base64 of username:password).
DEALHUB_WEBHOOK_USERNAME=
DEALHUB_WEBHOOK_PASSWORD=

