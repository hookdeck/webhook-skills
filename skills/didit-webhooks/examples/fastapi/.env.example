# The destination's secret_shared_key, returned once by POST /v3/webhook/destinations/
# (or shown in Business Console > API & Webhooks). Used as a raw string, not decoded.
DIDIT_WEBHOOK_SECRET=your_secret_shared_key

# Optional: max age of X-Timestamp in seconds (Didit recommends 300). Set 0 to skip the check.
# DIDIT_TIMESTAMP_TOLERANCE_SECONDS=300
