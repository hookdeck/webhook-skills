# The destination's secret_shared_key, returned once by POST /v3/webhook/destinations/
# (or shown in Business Console > API & Webhooks). Used as a raw string, not decoded.
DIDIT_WEBHOOK_SECRET=your_secret_shared_key

# Optional: max age of X-Timestamp in seconds. 0 (default) skips the check, because Hookdeck
# retries and replays keep the original X-Timestamp. Didit recommends 300 if you opt in.
DIDIT_TIMESTAMP_TOLERANCE_SECONDS=0
