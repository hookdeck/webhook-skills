# Rubrik Security Cloud webhooks are NOT signed. Pick the auth mode you set on
# the webhook in Rubrik (authInfo.authType) and fill in the matching values.
# With nothing configured, every request is rejected.

# CUSTOM_HEADER (recommended): the header key and value you entered in Rubrik
RUBRIK_WEBHOOK_HEADER_NAME=X-Rubrik-Webhook-Token
RUBRIK_WEBHOOK_SECRET=replace-with-a-long-random-string

# BEARER: the token Rubrik sends as "Authorization: Bearer <token>"
RUBRIK_WEBHOOK_BEARER_TOKEN=

# BASIC: the username/password you entered in Rubrik
RUBRIK_WEBHOOK_USERNAME=
RUBRIK_WEBHOOK_PASSWORD=

PORT=3000
