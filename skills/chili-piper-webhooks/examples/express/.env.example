# Webhook signing secret. Chili Piper issues it on request:
# email support@chilipiper.com with your tenant name and webhook.
CHILI_PIPER_WEBHOOK_SECRET=your_webhook_signing_secret_here

# Optional replay protection. 0 or unset (default) disables the check.
# Hookdeck retries and replays resend the original timestamp, so a window
# rejects them. Chili Piper's own example uses 300.
CHILI_PIPER_WEBHOOK_TOLERANCE_SECONDS=0
