# Upload-Post webhook secret: paste the WHOLE secret, including the whsec_ prefix
UPLOAD_POST_WEBHOOK_SECRET=whsec_your_webhook_secret

# Optional: reject deliveries whose X-Upload-Post-Timestamp is older/newer than this many seconds.
# Unset or 0 = off (recommended behind Hookdeck, whose retries and replays keep the original timestamp)
UPLOAD_POST_WEBHOOK_TOLERANCE_SECONDS=0
