# Yoco webhook signing secret (Standard Webhooks, "whsec_" + base64).
# Returned ONCE in the `secret` field when you create the subscription:
#   Yoco API:     POST https://api.yoco.com/v1/webhooks/subscriptions/
#   Checkout API: POST https://payments.yoco.com/api/webhooks
# If you lose it, rotate it (Yoco API) or register a new webhook (Checkout API).
YOCO_WEBHOOK_SECRET=whsec_your_base64_secret_here

# Port the example server listens on
PORT=3000
