# Infinite Giving partner signing secret, given at partner kickoff.
# Used as plain UTF-8 text (not hex- or base64-decoded).
INFINITE_GIVING_WEBHOOK_SECRET=your_partner_signing_secret

# Optional: reject X-IG-Timestamp (Unix seconds) older/newer than this many seconds.
# Unset or 0 = off (recommended: retries and replays resend the original timestamp).
INFINITE_GIVING_WEBHOOK_TOLERANCE_SECONDS=0

PORT=8000
