# Arcadia support sets the header name and value: open a support ticket to request one.
# Values cannot contain spaces.
# Header name Arcadia support configured (default: X-Arcadia-Token)
ARCADIA_WEBHOOK_HEADER=X-Arcadia-Token
# The exact, whole header value (compared as-is, including any prefix you typed)
ARCADIA_WEBHOOK_SECRET=your-header-value
