# Your Cashfree client secret (x-client-secret). For partner-level webhooks use the Partner API key.
# Legacy Payouts V1 and Cashgram webhooks use another scheme and fail verification.
CASHFREE_WEBHOOK_SECRET=your_cashfree_client_secret_here

# Optional replay window in seconds. Unset or 0 = off (the default). Cashfree's docs suggest
# 5 minutes (300). Retries and replays resend the original timestamp, so leave it off if you
# receive through Hookdeck or rely on Cashfree retries.
# CASHFREE_WEBHOOK_TOLERANCE_SECONDS=0

PORT=8000
