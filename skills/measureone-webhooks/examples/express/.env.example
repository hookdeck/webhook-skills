# MeasureOne does not sign webhooks. You add a static header to delivery_details[].headers on
# each Data Request, and this app checks it.
# Name of that header (you choose it). Defaults to Authorization.
MEASUREONE_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any "Bearer " prefix you typed.
MEASUREONE_WEBHOOK_SECRET=Bearer your-shared-secret
