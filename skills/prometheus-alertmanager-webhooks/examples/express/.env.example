# Configure the form your receiver's http_config uses (or both). A form left unset is rejected.

# authorization (default type Bearer): the bare credentials from alertmanager.yml
# (credentials or credentials_file). Do not include the "Bearer " prefix; Alertmanager adds it.
ALERTMANAGER_WEBHOOK_SECRET=your-shared-secret

# basic_auth: the username and password from alertmanager.yml
ALERTMANAGER_WEBHOOK_USERNAME=
ALERTMANAGER_WEBHOOK_PASSWORD=
