# Subscription secret returned once by the create webhook subscription API call. Used as-is.
PENNYLANE_WEBHOOK_SECRET=your_subscription_secret
PORT=3000

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
PENNYLANE_TIMESTAMP_TOLERANCE_SECONDS=0
