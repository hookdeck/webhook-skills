# The hmacKey you chose when creating the webhook subscription
# (POST /webhooks/subscriptions). Used as-is, as UTF-8 bytes.
GREENSHADES_WEBHOOK_SECRET=your_hmac_key_here

# Optional: reject deliveries whose X-GS-TIMESTAMP is older than this many seconds.
# Unset or 0 = off (the default). Hookdeck retries and replays resend the original
# timestamp, so leave this off unless you need it.
# GREENSHADES_WEBHOOK_TOLERANCE_SECONDS=300

# Server port (optional, defaults to 8000)
PORT=8000
