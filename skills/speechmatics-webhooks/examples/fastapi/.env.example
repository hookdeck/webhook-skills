# Speechmatics does not sign notifications. You add a header to the job via
# notification_config[].auth_headers (e.g. "Authorization: Bearer <token>") and Speechmatics
# sends it verbatim on every callback. The header name is yours to choose (default
# Authorization); the secret is the EXACT, WHOLE header value, including any "Bearer " prefix.
# Generate a token with: openssl rand -hex 32
SPEECHMATICS_WEBHOOK_HEADER=Authorization
SPEECHMATICS_WEBHOOK_SECRET="Bearer replace-with-a-long-random-token"
