# Auvik webhooks are unsigned. Authenticate with the secret header you add on the
# Auvik webhook (Header authentication: Key and Value).
# Header name (the "Key"); defaults to Authorization. Matched case-insensitively.
AUVIK_WEBHOOK_HEADER=Authorization
# The exact, whole header value (the "Value"), including any "Bearer " prefix you typed.
AUVIK_WEBHOOK_SECRET=your-header-value
