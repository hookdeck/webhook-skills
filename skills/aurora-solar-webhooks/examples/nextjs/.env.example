# Name of the header you set as header_auth_key on the Aurora Solar webhook subscription.
# Defaults to X-Aurora-Webhook-Token (the name used in Aurora's docs); it is user-chosen.
AURORA_SOLAR_WEBHOOK_HEADER=X-Aurora-Webhook-Token

# The exact, whole header_auth_value (include any "Bearer " prefix if you typed one).
AURORA_SOLAR_WEBHOOK_SECRET=your-header-auth-value
