# Campfire webhook signing secret: the 50-character `token` returned when the
# webhook is created (or the "HMAC-SHA256 Secret" on the webhook card under
# Settings > Developer > Webhooks > Show). It is used as-is, as UTF-8 text:
# do NOT hex- or base64-decode it. Campfire generates it; you cannot set it.
CAMPFIRE_WEBHOOK_SECRET=your-50-character-signing-secret

# Optional replay protection, in seconds. Unset or 0 = off (the default).
# Campfire's docs suggest 300 (5 minutes). Retries are re-signed with a fresh
# timestamp, but Hookdeck retries and replays resend the ORIGINAL headers, so
# leave this off when receiving through Hookdeck.
# CAMPFIRE_WEBHOOK_TOLERANCE_SECONDS=300

PORT=3000
