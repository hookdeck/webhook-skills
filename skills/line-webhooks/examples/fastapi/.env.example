# LINE channel secret for the Messaging API channel that sends the webhooks.
# LINE Developers Console -> your Messaging API channel -> Basic settings -> Channel secret
#
# Used verbatim as the HMAC-SHA256 key (UTF-8 bytes). This is NOT the channel access token.
# The signature is base64(HMAC-SHA256(channel secret, raw request body)), sent in x-line-signature.
LINE_CHANNEL_SECRET=your_channel_secret

# Port for the FastAPI server (uvicorn)
PORT=8000
