# Signing secret of your sajn webhook endpoint ("whsec_" + base64).
# sajn returns it only in the POST /api/v1/webhooks response and when you rotate
# it (POST /api/v1/webhooks/{id}/rotate-secret). Each endpoint has its own secret.
# The endpoint must use API version 2026-10 or later.
SAJN_WEBHOOK_SECRET=whsec_your_signing_secret_here

PORT=3000
