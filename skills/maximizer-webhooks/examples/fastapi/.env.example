# Maximizer does not sign webhooks. You choose a header when you create the target
# (Endpoint.Headers [{ "Key": ..., "Value": ... }]) and Maximizer sends it on every request.
# Name of that header (default: Authorization). Matched case-insensitively.
MAXIMIZER_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any "Bearer " prefix you typed into the target.
MAXIMIZER_WEBHOOK_SECRET=Bearer your-long-random-secret
