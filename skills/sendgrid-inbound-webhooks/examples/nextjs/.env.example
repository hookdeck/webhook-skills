# ---------------------------------------------------------------------------
# Twilio SendGrid Inbound Parse
#
# This is Inbound Parse (receiving email), NOT the SendGrid Event Webhook
# (delivered / bounce / open / click). They share these two header names and
# the ECDSA primitive, and nothing else.
# ---------------------------------------------------------------------------

# The public key for signature verification.
#
# Source: the `policy.signature.public_key` value returned by
#   POST https://api.sendgrid.com/v3/user/webhooks/security/policies
# then attached to your Parse Setting with
#   PATCH https://api.sendgrid.com/v3/user/webhooks/parse/settings/{hostname}
#
# FORMAT: base64 DER SubjectPublicKeyInfo — NOT PEM. There are no
# -----BEGIN PUBLIC KEY----- lines. Paste the value exactly as the API returned
# it; the handler decodes it. (A PEM block also works if you prefer.)
#
# Verify what you pasted:
#   echo "$SENDGRID_INBOUND_PUBLIC_KEY" | base64 -d | openssl pkey -pubin -inform DER -text -noout
#
# LEAVE UNSET only if your Parse Setting genuinely has no security policy
# attached. Inbound Parse signing is OPT-IN: with no policy, SendGrid sends no
# signature header at all. The handler then accepts requests but logs a loud
# warning. Once this is set, verification is strictly enforced — it never
# falls back to accepting unsigned requests.
SENDGRID_INBOUND_PUBLIC_KEY=

# Optional replay window, in seconds. Unset or 0 disables the check.
#
# The timestamp header is a real Unix timestamp, not a nonce, so a freshness
# check is meaningful. It is off by default on purpose: silently dropping
# inbound mail because of clock skew is worse than accepting a slightly old
# signed request. Run NTP before enabling this.
SENDGRID_INBOUND_MAX_AGE_SECONDS=

# Set to true when your security policy includes an `oauth` block. SendGrid
# then sends `Authorization: Bearer <token>` on every POST, fetched from the
# token_url you designated. Validate it against YOUR authorization server —
# see validateAccessToken() in src/index.js.
SENDGRID_INBOUND_REQUIRE_OAUTH=false

# DEMO ONLY. Comma-separated tokens the placeholder validateAccessToken()
# accepts, so the OAuth path is runnable and testable out of the box. Replace
# that function with real JWKS or RFC 7662 introspection and delete this.
SENDGRID_INBOUND_OAUTH_ACCEPTED_TOKENS=

# Next.js listens on 3000 by default (npm run dev).

# NOTE: none of these are NEXT_PUBLIC_ prefixed, and they must not be. A
# NEXT_PUBLIC_ variable is inlined into the client bundle and served to every
# visitor. Route handlers run server-side and read process.env directly.
