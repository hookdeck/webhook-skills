# Particle does not sign webhooks. You add a secret header to the webhook integration
# (Custom headers, e.g. {"Authorization": "Bearer 12345"}) and this app checks it.
# Name of the header you added (case-insensitive). Defaults to Authorization.
PARTICLE_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any "Bearer " prefix you typed.
PARTICLE_WEBHOOK_SECRET=Bearer replace-with-a-long-random-string
