# PubNub does not sign webhooks. You add a secret custom header to the Webhook action
# (Admin Portal > Events & Actions > Webhook action > custom headers, value from a keyset secret).
# Name of that header (default: Authorization). Matched case-insensitively.
PUBNUB_WEBHOOK_HEADER=Authorization
# The exact, whole header value, including any prefix you typed (for example "Bearer abc123").
PUBNUB_WEBHOOK_SECRET=your-shared-secret
