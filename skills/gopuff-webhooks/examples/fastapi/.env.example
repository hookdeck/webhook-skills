# Svix endpoint signing secret (starts with whsec_)
# Get this from the Svix App Portal > Endpoints > Signing Secret
GOPUFF_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
GOPUFF_TIMESTAMP_TOLERANCE_SECONDS=0
