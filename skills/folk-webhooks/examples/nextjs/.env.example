# Signing secret of your folk webhook ("whsec_" + base64), for example
# whsec_QWFSUzl1QUVoQW1kdWtpTnJRTUFpbXNlZmxLTg==
# folk shows it ONCE, when the webhook is created (workspace API settings page
# or POST https://api.folk.app/v1/webhooks). If you lose it, create a new webhook.
FOLK_WEBHOOK_SECRET=whsec_your_signing_secret_here
