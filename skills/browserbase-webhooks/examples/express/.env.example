# Browserbase webhook signing secret (Standard Webhooks, "whsec_" + base64).
# Browserbase shows it ONCE: in the create response (dashboard dialog,
# bb.webhooks.create, POST /v1/webhooks) or the rotate response. No endpoint
# reads it back, so store it here/in your vault straight away.
BROWSERBASE_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Optional: the previous secret after a rotation. Browserbase keeps it
# verifying for 24 hours; remove it once that window has passed.
BROWSERBASE_WEBHOOK_SECRET_PREVIOUS=

# Port the example server listens on
PORT=3000
