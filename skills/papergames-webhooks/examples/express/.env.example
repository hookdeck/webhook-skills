# Papergames webhook secret (Svix format, starts with whsec_)
# Shown once in the Papergames developer tools right after you create the webhook endpoint
PAPERGAMES_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: max age of svix-timestamp in seconds (default 300, the Svix libraries' default; 0 disables)
PAPERGAMES_WEBHOOK_TOLERANCE_SECONDS=300

PORT=3000
