# GitLab signing token (recommended, GitLab 19.0+). Generated by GitLab under
# Settings > Webhooks > "Generate signing token"; shown once, starts with whsec_.
GITLAB_WEBHOOK_SIGNING_TOKEN=whsec_your_gitlab_signing_token_here

# Legacy secret token (optional, sent as plain text in X-Gitlab-Token).
# GitLab does not recommend it for new webhooks. Generate with: openssl rand -hex 32
GITLAB_WEBHOOK_TOKEN=your_gitlab_webhook_token_here
