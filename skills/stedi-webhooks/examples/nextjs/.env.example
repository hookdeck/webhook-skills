# Signing secret of your Stedi event destination ("whsec_" + base64).
# Stedi portal: Settings > Developer > Event destinations > your destination > Overview > Signing secret,
# or GET https://events.us.stedi.com/2026-02-01/destinations/{destinationId}/secret
# Each event destination has its own secret.
STEDI_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Optional replay window in seconds. 0 (default) disables the check.
# webhook-timestamp is when Stedi CREATED the event, so retries (up to 48 hours) always look old.
STEDI_TIMESTAMP_TOLERANCE_SECONDS=0


