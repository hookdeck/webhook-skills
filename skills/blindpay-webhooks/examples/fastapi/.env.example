# BlindPay webhook signing secret (Svix format: "whsec_" + base64), including the whsec_ prefix.
# Dashboard -> instance -> Webhooks -> endpoint menu -> Get secret, or
# GET /v1/instances/{instance}/webhook-endpoints/{we_id}/secret (returns { "key": "whsec_..." }).
BLINDPAY_WEBHOOK_SECRET=whsec_your_secret_here

# Port the example server listens on
PORT=8000
