# CallRail company signing key (Settings → Integrations → Webhooks page)
CALLRAIL_SIGNING_KEY=your_company_signing_key_here

# Optional replay protection. 0 (default) disables the check.
# CallRail's `timestamp` is the call start time and post-call webhooks can
# arrive up to ~20 minutes after hangup, so use a generous window (e.g. 3600).
CALLRAIL_TIMESTAMP_TOLERANCE_SECONDS=0
