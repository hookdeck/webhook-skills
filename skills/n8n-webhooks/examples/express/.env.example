# Shared secret configured on the n8n HTTP Request node's credential.
# Header auth: credential Value = this secret (header name below).
# Bearer auth: credential Bearer Token = this secret.
# Generate one with: openssl rand -hex 32
N8N_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Header name used by the Header auth credential (case-insensitive).
N8N_WEBHOOK_HEADER=X-Webhook-Secret

# Optional: Basic auth credential (leave empty to disable Basic auth)
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=
