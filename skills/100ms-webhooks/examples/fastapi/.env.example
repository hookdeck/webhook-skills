# 100ms webhooks are not signed. Add a secret header to the webhook in the 100ms dashboard
# (Developer > Webhook) and enter the same values here.
# Header name you chose (default: Authorization). Looked up case-insensitively.
HUNDRED_MS_WEBHOOK_HEADER=Authorization
# The EXACT, whole header value, including any "Bearer " prefix you typed in the dashboard.
HUNDRED_MS_WEBHOOK_SECRET=your-secret-header-value
