# Breakcold endpoint signing secret:
#   Settings -> Webhook -> Send -> New outbound webhook -> copy the signing secret
# Used as UTF-8 bytes exactly as copied (not hex- or base64-decoded).
BREAKCOLD_WEBHOOK_SECRET=your_breakcold_signing_secret

# Optional replay protection. Unset or 0 = off (the default).
# Hookdeck retries and replays resend the ORIGINAL X-Webhook-Timestamp, so a
# window rejects legitimate retries. Only enable it when Breakcold calls this
# endpoint directly.
# BREAKCOLD_WEBHOOK_TOLERANCE_SECONDS=300

PORT=8000
