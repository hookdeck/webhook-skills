# Argo CD does not sign webhooks. Authenticate with a header you add to the webhook service
# (service.webhook.<name>.headers in argocd-notifications-cm).
# Header name you configured (default: Authorization):
ARGO_CD_WEBHOOK_HEADER=Authorization
# The exact, whole header value you configured, including any "Bearer " prefix you typed:
ARGO_CD_WEBHOOK_SECRET=Bearer your-shared-secret
