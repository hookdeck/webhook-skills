# Autumn webhook signing secret (Svix format: "whsec_" + base64).
# Returned ONCE by webhooks.create / webhooks.sync (or shown when you add the endpoint
# in the dashboard). webhooks.get never returns it.
AUTUMN_WEBHOOK_SECRET=whsec_your_secret_here

# Optional timestamp window for the manual verifier, in seconds, or "off" to disable it.
# Leave empty to use the svix library, which always enforces a fixed 5-minute window and
# therefore rejects Hookdeck retries/replays of older events.
AUTUMN_TIMESTAMP_TOLERANCE_SECONDS=

# Port the example server listens on
PORT=8000
