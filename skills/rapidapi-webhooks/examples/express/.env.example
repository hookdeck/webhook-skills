# Webhook secret key from the RapidAPI Enterprise Hub: Admin Panel > Events.
# It is sent in the x-rapidapi-webhook-secret header; "Generate new" rotates it.
RAPIDAPI_WEBHOOK_SECRET=your-webhook-secret-key

# Optional: name of the JSON body field that holds the event type, e.g. "API Created".
# The body format isn't documented; send a "Test event" and copy the field name you see.
RAPIDAPI_EVENT_FIELD=
