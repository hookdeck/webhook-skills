# The `secret` you set on the Socotra webhook endpoint (8-64 alphanumerics or underscores).
# Turn on hmacEnabled for the endpoint and leave its `tag` unset.
SOCOTRA_WEBHOOK_SECRET=your_socotra_webhook_secret

# Optional: reject deliveries whose t= is older/newer than this many seconds.
# Unset or 0 = off (the default). Hookdeck retries and replays resend the original
# timestamp, so only enable this when Socotra calls your endpoint directly.
# SOCOTRA_WEBHOOK_TOLERANCE_SECONDS=300
