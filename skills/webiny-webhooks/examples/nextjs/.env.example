# The signing secret exactly as entered in Webiny: the webhook's own secret
# (Webiny 6) or the global secret in Webhook settings. It is free text, not a
# whsec_ value. Do not add a prefix or base64-encode it.
WEBINY_WEBHOOK_SECRET=your_webiny_signing_secret_here

# Optional: reject deliveries whose webhook-timestamp is older than this many
# seconds. Off by default because retries and replays reuse the original timestamp.
# WEBINY_WEBHOOK_TOLERANCE_SECONDS=300

PORT=3000
