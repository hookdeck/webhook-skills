# Webhook API key from the Developers page of the MoonPay dashboard (e.g. wk_test_xxxxx / wk_live_xxxxx).
# Use the test key for test-mode endpoints and the live key for live-mode endpoints.
MOONPAY_WEBHOOK_API_KEY=wk_test_xxxxx

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
MOONPAY_TIMESTAMP_TOLERANCE_SECONDS=0
