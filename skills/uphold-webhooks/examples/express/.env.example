# Uphold webhook endpoint signing secret ("whsec_" + base64).
# Copy it from the Webhooks Portal (Svix-hosted): open the portal from the
# Enterprise Portal → Webhooks, or via POST /core/webhooks/management-link,
# then select your endpoint and reveal its Signing Secret.
# Sandbox and Production endpoints have different secrets.
UPHOLD_WEBHOOK_SECRET=whsec_your_base64_secret_here

# Port the example server listens on
PORT=3000
