# Worldline webhooks key: the id and the secret key of a WEBHOOKS key (not your REST API key).
# Connect: Configuration Center > webhooks keys. Direct: Merchant Portal > Developer > Webhooks.
WORLDLINE_WEBHOOK_KEY_ID=your-webhooks-key-id
WORLDLINE_WEBHOOK_SECRET=your-webhooks-secret-key
# Optional: a second key while rotating. Connect signs with the OLDEST key on the account,
# and the X-GCS-KeyId header says which one was used.
WORLDLINE_WEBHOOK_KEY_ID_PREVIOUS=
WORLDLINE_WEBHOOK_SECRET_PREVIOUS=
# Optional defence-in-depth (Connect "webhooks header"): checked IN ADDITION to the HMAC.
# The name must start with X- and cannot be X-GCS-*.
WORLDLINE_CUSTOM_HEADER_NAME=
WORLDLINE_CUSTOM_HEADER_VALUE=
# Port the example server listens on
PORT=8000
