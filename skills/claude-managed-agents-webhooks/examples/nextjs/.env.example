# Anthropic Claude Managed Agents Webhook Configuration
# The signing key is a 32-byte secret with the "whsec_" prefix.
# Generated once when you create the endpoint in Console:
#   Console -> Manage -> Webhooks -> Add endpoint
# Treat it like a password — store it securely and never commit it.
ANTHROPIC_WEBHOOK_SIGNING_KEY=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Anthropic API key, required if you fetch the full resource
# (e.g. client.beta.sessions.retrieve(event.data.id)) from inside the handler.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
