# Endpoint secret returned ONCE when you create the webhook endpoint (POST /v4/webhook_endpoints
# or app.kit.com/webhooks). Looks like whsec_xxx; use the whole string, prefix included.
KIT_WEBHOOK_SECRET=whsec_xxxxx

# Optional replay window in seconds. 0 (default) turns the timestamp check off, because
# retries and replays (including Hookdeck's) carry the original timestamp. A positive value opts in.
KIT_TIMESTAMP_TOLERANCE_SECONDS=0
