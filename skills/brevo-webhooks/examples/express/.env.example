# Configure at least one method, matching how you created the Brevo webhook.

# Basic auth: create the webhook with the credentials in the notify URL,
#   https://username:password@your-domain.com/webhooks/brevo
# Brevo then sends: Authorization: Basic base64(username:password)
BREVO_WEBHOOK_USERNAME=your_webhook_username
BREVO_WEBHOOK_PASSWORD=your_webhook_password

# Bearer token: create the webhook with "auth": {"type": "bearer", "token": "..."}
# Brevo then sends: Authorization: Bearer <token>
BREVO_WEBHOOK_TOKEN=your_webhook_token
