# Your Cloudinary account API Secret. It is the `api_secret` in
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>, also found under
# Console → Settings → API Keys. Cloudinary signs each notification with THIS
# secret (there is NO separate per-webhook signing secret). The handler verifies
# the x-cld-signature / x-cld-timestamp headers against it.
CLOUDINARY_API_SECRET=your_account_api_secret

# Digest algorithm Cloudinary uses to sign notifications: sha1 (default) or
# sha256 (opt-in account setting). Leave unset for the sha1 default.
# CLOUDINARY_SIGNATURE_ALGORITHM=sha1
