# Signing secret: the value you passed to `heroku webhooks:add --secret`,
# or the one the CLI printed once when it generated it for you
HEROKU_WEBHOOK_SECRET=your_webhook_secret

# Optional: the value you passed to `heroku webhooks:add --authorization`.
# When set, requests whose Authorization header does not match are rejected.
# HEROKU_WEBHOOK_AUTHORIZATION=Bearer your_token
